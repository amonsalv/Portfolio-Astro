---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const allProjects = await getCollection('work');
const projects = allProjects
	.filter((project: CollectionEntry<'work'>) => !project.id.includes('-es'))
	// Telas 3B stays in the full /work/ listing but is swapped out of the home
	// spotlight in favor of Ordenary, its in-progress successor.
	.filter((project: CollectionEntry<'work'>) => !project.id.includes('telas3b'))
	.sort(
		(a: CollectionEntry<'work'>, b: CollectionEntry<'work'>) =>
			b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
	)
	.slice(0, 3);
---

<BaseLayout title="Ana Monsalve | Developer & Painter" description="Ana Monsalve — Software Development Apprentice at NTT DATA, automation engineer, and artist from Medellín, Colombia.">
	<main class="home-page">
		<section class="hero">
			<div class="orb orb-1" aria-hidden="true"></div>
			<div class="orb orb-2" aria-hidden="true"></div>
			<div class="wrapper hero-wrapper">
				<div class="hero-grid">

					<!-- Left: text -->
					<div class="hero-left">
						<span class="hero-location" data-enter style="--delay:150ms" data-translate="heroLocation">Software Development Apprentice @ NTT DATA · Medellín, Colombia</span>
						<h1 class="hero-title" data-enter style="--delay:300ms" data-translate="heroTitle">
							<span class="line-code">I write code</span>
							<span class="line-paint">like I paint.</span>
						</h1>
						<p class="hero-tagline" data-enter style="--delay:480ms" data-translate="heroTagline">
							Building technology with intention. Combining the logic of code with the soul of a painter.
						</p>
						<div class="hero-ctas" data-enter style="--delay:620ms">
							<a class="hero-btn-primary" href="/work/" data-translate="heroCta">View my work</a>
							<a class="hero-btn-ghost" href="/about/" data-translate="heroAbout">About me</a>
						</div>
					</div>

					<!-- Right: code card art -->
					<div class="hero-art" aria-hidden="true" data-enter style="--delay:500ms">
						<span class="float-shape fs1"></span>
						<span class="float-shape fs2"></span>
						<span class="float-shape fs3"></span>
						<div class="code-card">
<pre><span class="cc">// automation/sync.py</span>
<span class="ck">async def</span> <span class="cv">sync_orders</span>(client):
    orders = <span class="ck">await</span> client\
        .<span class="cv">fetch</span>(<span class="cs">"/api/orders"</span>)

    <span class="ck">return</span> [
        <span class="cv">to_invoice</span>(o)
        <span class="ck">for</span> o <span class="ck">in</span> orders
        <span class="ck">if</span> o.<span class="cv">pending</span>
    ]</pre>
							<div class="brushstroke"></div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<section class="think bg-mist">
			<div class="wrapper think-inner">
				<span class="sec-numeral sec-numeral-right" aria-hidden="true">01</span>
				<div class="sec-head think-head reveal">
					<span class="sec-label">01 — Philosophy</span>
					<h2 class="section-title" data-translate="thinkTitle">How I think</h2>
					<p class="sec-lede" data-translate="thinkSubtitle">Before the work, the way of working. Three principles that hold every project together.</p>
				</div>
				<div class="think-grid reveal" data-stagger>
					<article class="think-card curiosity">
						<div class="icon">✦</div>
						<h3 data-translate="thinkCuriosityTitle">Curiosity</h3>
						<p data-translate="thinkCuriosityDesc">I approach every challenge like a blank canvas, asking the right questions before mixing the colors.</p>
					</article>
					<article class="think-card logic">
						<div class="icon">▦</div>
						<h3 data-translate="thinkLogicTitle">Logic</h3>
						<p data-translate="thinkLogicDesc">Structured systems and scalable architecture are the foundations that allow creativity to truly fly.</p>
					</article>
					<article class="think-card purpose">
						<div class="icon">◎</div>
						<h3 data-translate="thinkPurposeTitle">Purpose</h3>
						<p data-translate="thinkPurposeDesc">I build for humans. Technology should solve real problems and carry intention.</p>
					</article>
				</div>
			</div>
		</section>

		<section class="selected-work">
			<div class="wrapper">
				<span class="sec-numeral sec-numeral-left" aria-hidden="true">02</span>
				<header class="sec-head work-head reveal">
					<span class="sec-label">02 — Work</span>
					<div class="sec-head-row">
						<h2 class="section-title" data-translate="workTitle">Selected Work</h2>
						<a class="see-all-link" href="/work/" data-translate="workSeeAll">See all work →</a>
					</div>
					<p class="sec-lede" data-translate="workSubtitle">Three projects, shown with the thinking behind them — not just the screenshots.</p>
				</header>
				<ul class="work-bento reveal" data-stagger>
					{
						projects.map((project, idx) => {
							const spanishId = project.id.includes('.md') ? project.id.replace('.md', '-es.md') : `${project.id}-es`;
							const spanishProject = allProjects.find((p) => p.id === spanishId);
							const slot = `slot-${idx + 1}`;
							return (
								<li class:list={['project-item', slot]} data-en-slug={project.id} data-es-slug={spanishId}>
									<div class="project-en" style="display: block;">
										<a class="work-card" href={`/work/${project.id}`}>
											<div class="meta">
												<div class="tags">
													{project.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
												</div>
												<h3>{project.data.title}</h3>
												<p>{project.data.description}</p>
												<div class="proj-stack">
													{project.data.tags.slice(0, 4).map((tag: string) => <span class="dot">{tag}</span>)}
												</div>
												<span class="read-more" aria-hidden="true">View Case Study <Icon icon="arrow-right" size="1.2em" /></span>
											</div>
											<div class="img-container">
												<img src={project.data.img} alt={project.data.img_alt || ''} loading="lazy" decoding="async" />
											</div>
										</a>
									</div>
									{spanishProject && (
										<div class="project-es" style="display: none;">
											<a class="work-card" href={`/work/${spanishProject.id}`}>
												<div class="meta">
													<div class="tags">
														{spanishProject.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
													</div>
													<h3>{spanishProject.data.title}</h3>
													<p>{spanishProject.data.description}</p>
													<div class="proj-stack">
														{spanishProject.data.tags.slice(0, 4).map((tag: string) => <span class="dot">{tag}</span>)}
													</div>
													<span class="read-more" aria-hidden="true">Ver Caso de Estudio <Icon icon="arrow-right" size="1.2em" /></span>
												</div>
												<div class="img-container">
													<img src={spanishProject.data.img} alt={spanishProject.data.img_alt || ''} loading="lazy" decoding="async" />
												</div>
											</a>
										</div>
									)}
								</li>
							);
						})
					}
					<li class="project-item slot-4">
						<div class="work-card cta-dark-card">
							<div class="cta-dark-content">
								<span class="stars-icon">✦ ✦ ✦</span>
								<h3 data-translate="workCtaCard">Ready for your next collaboration?</h3>
								<a href="/about/#contact" class="button-contact" data-translate="ctaButton">Contact Ana</a>
							</div>
						</div>
					</li>
				</ul>
			</div>
		</section>

		<section class="growing">
			<div class="wrapper grow-grid">
				<div class="grow-copy reveal">
					<p class="grow-pill" data-translate="growPill">Evolution</p>
					<h2 data-translate="growTitle">What I'm growing into</h2>
					<p class="grow-desc" data-translate="growDesc">Currently obsessed with the infrastructure that makes great apps possible — bridging the gap between code and deployment.</p>
					<div class="grow-tags">
						<span class="tag-cloud"><Icon icon="cloud" size="1.2em" /> Cloud Computing</span>
						<span class="tag-devops"><Icon icon="gear" size="1.2em" /> DevOps</span>
						<span class="tag-auto"><Icon icon="lightning" size="1.2em" /> Automation</span>
					</div>
				</div>
				<div class="grow-visual reveal" aria-hidden="true">
					<svg class="star-icon star-1" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
					</svg>
					<svg class="star-icon star-2" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
					</svg>
					<svg class="star-icon star-3" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
					</svg>
				</div>
			</div>
		</section>

		<section class="beyond bg-mist">
			<div class="wrapper">
				<span class="sec-numeral sec-numeral-right" aria-hidden="true">03</span>
				<div class="sec-head beyond-head reveal">
					<span class="sec-label">03 — Life</span>
					<h2 class="section-title" data-translate="beyondTitle">Beyond the Code</h2>
					<p class="sec-lede" data-translate="beyondSubtitle">A developer is a whole person. Here's what fills the hours the screen doesn't.</p>
				</div>
				<div class="beyond-bento reveal" data-stagger>

					<article class="panel panel-art" data-tilt>
						<div class="panel-icon">✎</div>
						<h3 data-translate="beyondPaintTitle">Writing, Painting &amp; Letters</h3>
						<p data-translate="beyondPaintDesc">When the screen goes quiet, creativity takes over. I express ideas through writing, painting, and letters that connect emotion with intention.</p>
						<div class="brush2" aria-hidden="true"></div>
					</article>

					<article class="panel panel-fit" data-tilt>
						<div class="fit-circle">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8v8M18 8v8M4 10v4M20 10v4M7 12h10"/></svg>
						</div>
						<h3 data-translate="beyondFitTitle">Active Lifestyle</h3>
						<p data-translate="beyondFitDesc">Building discipline through movement. CrossFit helps me stay focused, resilient, and mentally strong.</p>
					</article>

					<article class="panel panel-roots" data-tilt>
						<div class="dots" aria-hidden="true"></div>
						<div class="panel-icon">❖</div>
						<h3 data-translate="beyondRootsTitle">My roots are Colombia</h3>
						<p data-translate="beyondRootsDesc">Coffee, culture, and purposeful code. Proud of my roots and inspired by the energy, resilience, and creativity of my country.</p>
					</article>

					<article class="panel panel-comm" data-tilt>
						<div class="panel-icon">◈</div>
						<h3 data-translate="beyondCommTitle">Community &amp; Tech</h3>
						<p data-translate="beyondCommDesc">Organizer at GitTogether Medellín and Devs to Eternal. Creating spaces where people connect with technology and feel inspired.</p>
						<div class="circles" aria-hidden="true">
							<span style="background:var(--chroma-nature)"></span>
							<span style="background:color-mix(in srgb, var(--chroma-nature) 60%, #fff)"></span>
							<span style="background:color-mix(in srgb, var(--chroma-nature) 35%, #fff)"></span>
						</div>
					</article>

				</div>
			</div>
		</section>

		<section class="community wrapper" id="community">
			<span class="sec-numeral sec-numeral-left" aria-hidden="true">04</span>
			<div class="sec-head comm-head reveal">
				<span class="sec-label">04 — Community</span>
				<h2 class="section-title" data-translate="commTitle">Building together</h2>
				<p class="sec-lede" data-translate="commSubtitle">The best code happens when people connect. I create and participate in spaces where that spark exists.</p>
			</div>
			<div class="comm-grid reveal" data-stagger>

				<article class="comm-card comm-primary">
					<div class="comm-card-top">
						<span class="comm-role">Organizer</span>
						<h3>GitTogether Medellín</h3>
						<p data-translate="commGitDesc">A meetup for developers in Medellín — real talks, networking, and honest conversations about building software. I help create the space so others feel welcome to start.</p>
					</div>
					<div class="comm-card-footer">
						<a href="https://www.meetup.com/gittogether-medellin/" target="_blank" rel="noopener noreferrer" class="comm-btn-light">
							<span data-translate="commGitCta">Join on Meetup</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10"/></svg>
						</a>
					</div>
				</article>

				<article class="comm-card comm-secondary">
					<div class="comm-card-top">
						<span class="comm-role comm-role-blue">Organizer</span>
						<h3>Devs to Eternal</h3>
						<p data-translate="commDevsDesc">Community focused on sharing tech events and building meaningful connections in the developer ecosystem. Where learning and belonging go together.</p>
					</div>
					<div class="comm-card-footer">
						<a href="https://linktr.ee/devstoeternal" target="_blank" rel="noopener noreferrer" class="comm-btn-outline">
							<span data-translate="commDevsCta">Visit community</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10"/></svg>
						</a>
					</div>
				</article>

			</div>
		</section>

	</main>
</BaseLayout>

<style>
	.home-page {
		display: flex;
		flex-direction: column;
		gap: 0;
		--home-max: min(84rem, 92vw);
	}

	.home-page .wrapper {
		max-width: var(--home-max);
		padding-inline: clamp(1.2rem, 3vw, 3rem);
		margin-inline: auto;
	}

	/* ── Hero ── */
	.hero {
		position: relative;
		min-height: min(100svh, 900px);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero-wrapper {
		width: 100%;
		padding-block: 5rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		align-items: center;
		gap: 4rem;
	}

	.hero-left {
		position: relative;
		z-index: 2;
	}

	.hero-location {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--chroma-purple);
		margin-bottom: 1.25rem;
	}

	.hero-location::before {
		content: '';
		display: block;
		width: 32px;
		height: 2px;
		background: var(--chroma-purple);
		border-radius: 1px;
		flex-shrink: 0;
	}

	.hero-title {
		font-size: clamp(3rem, 8vw, 5.25rem);
		line-height: 0.92;
		letter-spacing: -0.04em;
		margin-bottom: 1.5rem;
	}

	:global(.hero-title .line-code) {
		display: block;
		font-family: var(--font-display);
		font-weight: 800;
		font-style: normal;
		color: var(--on-surface);
		letter-spacing: -0.04em;
	}

	:global(.hero-title .line-paint) {
		display: block;
		font-family: var(--font-display);
		font-weight: 300;
		font-style: italic;
		color: var(--chroma-ocean);
		letter-spacing: -0.04em;
	}

	.hero-tagline {
		max-width: 42ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--on-surface-variant);
		margin-bottom: 2rem;
	}

	.hero-ctas {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-btn-primary {
		display: inline-flex;
		align-items: center;
		height: 48px;
		padding-inline: 1.5rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 1rem;
		background: var(--chroma-ocean);
		color: #fff;
		box-shadow: 0 6px 18px color-mix(in srgb, var(--chroma-ocean) 35%, transparent);
		transition: transform 0.2s var(--ease-expressive), box-shadow 0.2s var(--ease-expressive);
		text-decoration: none;
	}
	.hero-btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px color-mix(in srgb, var(--chroma-ocean) 42%, transparent);
		color: #fff;
	}

	.hero-btn-ghost {
		display: inline-flex;
		align-items: center;
		height: 48px;
		padding-inline: 1.5rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 1rem;
		background: transparent;
		color: var(--chroma-red);
		border: 1.5px solid var(--chroma-red);
		transition: transform 0.2s var(--ease-expressive), background 0.2s var(--ease-expressive);
		text-decoration: none;
	}
	.hero-btn-ghost:hover {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--chroma-red) 8%, transparent);
		color: var(--chroma-red);
	}

	/* ── Hero art ── */
	.hero-art {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
	}

	.code-card {
		position: relative;
		width: min(360px, 100%);
		aspect-ratio: 360 / 460;
		border-radius: 2rem;
		background: linear-gradient(135deg, var(--chroma-ocean), var(--chroma-purple));
		transform: rotate(3deg);
		box-shadow: 0 30px 60px rgba(28, 24, 20, 0.18);
		padding: 1.75rem;
		overflow: hidden;
	}

	.code-card pre {
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.7;
		color: rgba(255,255,255,0.62);
		white-space: pre;
	}

	.code-card .ck { color: #fff; font-weight: 600; }
	.code-card .cs { color: #FCE3B8; }
	.code-card .cv { color: #CE93D8; }
	.code-card .cc { color: rgba(255,255,255,0.38); font-style: italic; }

	.brushstroke {
		position: absolute;
		bottom: -30px; right: -20px;
		width: 200px; height: 120px;
		background: radial-gradient(ellipse at center, var(--chroma-purple), transparent 70%);
		opacity: 0.5;
		filter: blur(6px);
		transform: rotate(-12deg);
	}

	/* Floating shapes */
	.float-shape {
		position: absolute;
		z-index: 2;
		border-radius: 3px;
	}
	.fs1 {
		width: 26px; height: 26px;
		background: var(--chroma-sunny);
		top: 6%; left: -6%;
		transform: rotate(20deg);
		animation: floaty 3.5s ease-in-out infinite;
	}
	.fs2 {
		width: 18px; height: 18px;
		background: var(--chroma-ocean);
		bottom: 14%; left: -10%;
		border-radius: 50%;
		animation: floaty 4.2s ease-in-out infinite 0.4s;
	}
	.fs3 {
		width: 22px; height: 22px;
		background: var(--chroma-purple);
		top: 18%; right: -8%;
		transform: rotate(45deg);
		animation: floaty 3.8s ease-in-out infinite 0.8s;
	}
	@keyframes floaty {
		0%, 100% { transform: translateY(-8px) rotate(var(--fr, 0deg)); }
		50%       { transform: translateY( 8px) rotate(var(--fr, 0deg)); }
	}

	@keyframes floaty2 {
		0%, 100% { transform: translateY(-6px) rotate(var(--sr, 0deg)); }
		50%       { transform: translateY( 6px) rotate(var(--sr, 0deg)); }
	}
	.fs1 { --fr: 20deg; }
	.fs3 { --fr: 45deg; }

	/* Orbs */
	.orb {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
	}
	.orb-1 {
		width: 45rem; height: 45rem;
		right: -8rem; top: -8rem;
		background: radial-gradient(circle, color-mix(in srgb, var(--chroma-ocean) 65%, transparent), transparent 70%);
		filter: blur(90px);
		animation: drift1 11s ease-in-out infinite;
	}
	.orb-2 {
		width: 32rem; height: 32rem;
		left: -10rem; bottom: -4rem;
		background: radial-gradient(circle, color-mix(in srgb, var(--chroma-purple) 55%, transparent), transparent 70%);
		filter: blur(90px);
		animation: drift2 9s ease-in-out infinite;
	}
	@keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-28px, 24px); } }
	@keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(26px, -22px); } }

	.think {
		padding: 5.5rem 0;
		position: relative;
		overflow: hidden;
	}

	.think-head {
		margin-bottom: 2.2rem;
	}

	.think-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
	}

	.think-card {
		background: var(--surface-container-lowest);
		border-radius: 1rem;
		padding: 1.4rem;
		border-top: 6px solid transparent;
		box-shadow: var(--shadow-sm);
	}

	.think-card .icon {
		width: 2.4rem;
		height: 2.4rem;
		display: grid;
		place-items: center;
		font-size: 1.1rem;
		border-radius: 0.6rem;
		margin-bottom: 0.8rem;
	}

	.think-card h3 {
		font-family: var(--font-body);
		font-size: 1.35rem;
		font-weight: 700;
		margin-bottom: 0.45rem;
	}

	.think-card p {
		color: var(--on-surface-variant);
		line-height: 1.5;
	}

	.think-card.curiosity {
		border-top: 3px solid var(--chroma-ocean);
	}

	.think-card.curiosity .icon {
		background: color-mix(in srgb, var(--chroma-ocean) 14%, transparent);
		color: var(--chroma-ocean);
	}

	.think-card.logic {
		border-top: 3px solid var(--chroma-purple);
	}

	.think-card.logic .icon {
		background: color-mix(in srgb, var(--chroma-purple) 14%, transparent);
		color: var(--chroma-purple);
	}

	.think-card.purpose {
		border-top: 3px solid var(--chroma-nature);
	}

	.think-card.purpose .icon {
		background: color-mix(in srgb, var(--chroma-nature) 14%, transparent);
		color: var(--chroma-nature);
	}

	/* ── Growing section ── */
	.growing {
		padding-top: 5.5rem;
		padding-bottom: 5.5rem;
	}

	.grow-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.grow-pill {
		display: inline-block;
		align-self: flex-start;
		background: #C62828 !important;
		color: #fff !important;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 6px 14px;
		border-radius: 999px;
		margin-bottom: 1.2rem;
	}

	.grow-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.grow-copy h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 0.98;
		letter-spacing: -0.03em;
		margin-bottom: 1.1rem;
	}

	.grow-desc {
		max-width: 40ch;
		font-size: 1.05rem;
		color: #464554 !important;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}
	:root.theme-dark .grow-desc {
		color: #c8c5db !important;
	}

	.grow-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.grow-tags span {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.9rem;
		border-radius: 0.5rem;
		background: var(--surface-container);
		font-weight: 600;
		font-size: 0.875rem;
	}

	.tag-cloud :global(svg) { color: var(--chroma-ocean); }
	.tag-devops :global(svg) { color: var(--chroma-purple); }
	.tag-auto :global(svg) { color: var(--chroma-nature); }

	.grow-visual {
		position: relative;
		min-height: 22rem;
		border-radius: 1.5rem;
		background: linear-gradient(135deg, #90CAF9 0%, #CE93D8 100%);
		overflow: hidden;
	}

	:root.theme-dark .grow-visual {
		background: linear-gradient(135deg, #0D47A1 0%, #4A148C 100%);
	}

	.star-icon {
		position: absolute;
		fill: rgba(255,255,255,0.85);
	}

	.star-1 {
		width: 6rem; height: 6rem;
		top: 38%; right: 22%;
		transform: rotate(15deg);
		animation: floaty2 4s ease-in-out infinite;
		--sr: 15deg;
	}

	.star-2 {
		width: 3.5rem; height: 3.5rem;
		top: 14%; right: 16%;
		transform: rotate(-10deg);
		animation: floaty2 3.4s ease-in-out infinite 0.5s;
		--sr: -10deg;
	}

	.star-3 {
		width: 3rem; height: 3rem;
		bottom: 16%; right: 30%;
		transform: rotate(5deg);
		animation: floaty2 3.8s ease-in-out infinite 1s;
		--sr: 5deg;
	}

	.selected-work {
		padding: 5.2rem 0;
		position: relative;
		overflow: hidden;
	}

	.work-head {
		margin-bottom: 3rem;
	}

	/* "Selected Work" title row with "See all →" link */
	.sec-head-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}

	.see-all-link {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--chroma-ocean);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 0.2rem;
		border-bottom: 1.5px solid var(--chroma-ocean);
		transition: opacity 0.2s;
		flex-shrink: 0;
	}
	.see-all-link:hover { opacity: 0.7; color: var(--chroma-ocean); }

	.work-head h2 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		line-height: 0.9;
		margin-bottom: 0;
	}

	.work-head p {
		font-size: var(--text-xl);
		max-width: 45ch;
		color: var(--on-surface-variant);
	}

	/* ── Work bento ── */
	.work-bento {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.work-card {
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
		border-radius: 2rem;
		background: var(--surface-container-lowest);
		box-shadow: 0 4px 20px rgba(0,0,0,0.04);
		text-decoration: none;
		color: inherit;
		transition: transform 0.3s var(--ease-expressive), box-shadow 0.3s var(--ease-expressive),
		            border-color 0.3s var(--ease-expressive);
		border: 1px solid transparent;
	}

	.work-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 40px rgba(0,0,0,0.09);
		border-color: color-mix(in srgb, var(--chroma-ocean) 30%, transparent);
	}

	:root.theme-dark .work-card {
		background: var(--surface-container);
		border-color: var(--surface-container-high);
	}

	/* Shared card parts */
	.work-card .meta {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 2rem;
		z-index: 2;
	}

	.work-card .tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.work-card .tags span {
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* Tags — paleta de Ana */
	.slot-1 .tags span { background: color-mix(in srgb, var(--chroma-ocean) 12%, transparent); color: var(--chroma-ocean-strong); }
	.slot-2 .tags span { background: color-mix(in srgb, var(--chroma-purple) 12%, transparent); color: var(--chroma-purple); }
	.slot-3 .tags span { background: color-mix(in srgb, var(--chroma-nature) 12%, transparent); color: var(--chroma-nature); }
	:root.theme-dark .slot-1 .tags span { background: color-mix(in srgb, var(--chroma-ocean) 22%, transparent); color: #90bfff; }
	:root.theme-dark .slot-2 .tags span { background: color-mix(in srgb, var(--chroma-purple) 22%, transparent); color: #e0a8f5; }
	:root.theme-dark .slot-3 .tags span { background: color-mix(in srgb, var(--chroma-nature) 22%, transparent); color: #80cbc4; }

	.work-card h3 {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--on-surface);
	}

	.work-card p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--on-surface-variant);
		max-width: 42ch;
	}

	.work-card .img-container {
		overflow: hidden;
		flex-shrink: 0;
	}

	.work-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--ease-expressive);
		display: block;
	}

	.work-card:hover img { transform: scale(1.04); }

	/* Stack dot badges */
	.proj-stack {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}
	.proj-stack .dot {
		font-family: var(--font-mono, monospace);
		font-size: 0.68rem;
		color: var(--on-surface-variant);
		border: 1px solid var(--outline-variant);
		border-radius: 6px;
		padding: 2px 8px;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1rem;
		font-weight: 700;
		font-size: 0.875rem;
		color: var(--chroma-ocean);
	}
	:root.theme-dark .read-more { color: #90bfff; }

	/* ── Overlay on hover ── */
	.img-overlay {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--on-surface) 35%, transparent);
		opacity: 0;
		transition: opacity 0.3s var(--ease-expressive);
	}
	.work-card:hover .img-overlay { opacity: 1; }
	.img-overlay span {
		background: #fff;
		color: var(--on-surface);
		padding: 8px 18px;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 700;
	}

	/* ── CTA card ── */
	.cta-dark-card {
		background: #0F121D !important;
		color: #fff;
		display: grid;
		place-items: center;
		padding: 3rem;
		text-align: center;
		border-color: transparent !important;
	}
	.cta-dark-card:hover { transform: none !important; }
	.cta-dark-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2rem;
	}
	.cta-dark-content h3 {
		font-family: var(--font-display) !important;
		color: #fff !important;
		font-size: clamp(1.6rem, 3vw, 2rem) !important;
		max-width: 18ch;
	}
	.stars-icon { font-size: 1.5rem; letter-spacing: 6px; }
	.button-contact {
		display: inline-flex;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		background: var(--chroma-ocean);
		color: #fff;
		font-weight: 700;
		font-size: 0.875rem;
		text-decoration: none;
		transition: background 0.2s;
	}
	.button-contact:hover { background: var(--chroma-ocean-strong); color: #fff; }

	.beyond {
		padding-top: 5rem;
		padding-bottom: 5rem;
		position: relative;
		overflow: hidden;
	}

	/* ── Beyond bento ── */
	.beyond-bento {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
		position: relative;
		z-index: 1;
	}

	.panel {
		position: relative;
		border-radius: 1.5rem;
		padding: 2.2rem;
		overflow: hidden;
		min-height: 220px;
		display: flex;
		flex-direction: column;
		transition: transform 0.3s var(--ease-expressive);
	}
	.panel:hover { transform: translateY(-4px); }

	.panel .panel-icon {
		font-size: 2rem;
		margin-bottom: 1.2rem;
	}

	.panel h3 {
		font-family: var(--font-body);
		font-size: 1.4rem;
		font-weight: 800;
		margin-bottom: 0.75rem;
		line-height: 1.15;
	}

	.panel p {
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* panel-art: purple gradient, span 2 cols */
	.panel-art {
		background: linear-gradient(135deg, #6A0DAD, #AB47BC);
		color: #fff;
	}
	.panel-art h3 { color: #fff; }
	.panel-art p  { color: rgba(255,255,255,0.88); max-width: 44ch; }
	.brush2 {
		position: absolute;
		bottom: -40px; right: -30px;
		width: 220px; height: 140px;
		background: radial-gradient(ellipse, rgba(255,255,255,0.35), transparent 70%);
		transform: rotate(-15deg);
	}

	/* panel-fit: yellow, centered */
	.panel-fit {
		background: #FFFDE7;
		color: #E65100;
		align-items: center;
		text-align: center;
		justify-content: center;
	}
	:root.theme-dark .panel-fit { background: #1A1500; color: #FFF176; }
	.fit-circle {
		width: 64px; height: 64px;
		border-radius: 50%;
		background: #FFF9C4;
		display: grid;
		place-items: center;
		margin: 0 auto 1.2rem;
	}
	:root.theme-dark .fit-circle { background: #2A2100; }
	.fit-circle svg {
		width: 30px; height: 30px;
		stroke: #E65100;
		stroke-width: 1.8;
		fill: none;
	}
	:root.theme-dark .fit-circle svg { stroke: #FFF176; }
	.panel-fit p { color: inherit; }

	/* panel-roots: green gradient, span 2 cols */
	.panel-roots {
		background: linear-gradient(135deg, #00897B, #004D40);
		color: #fff;
	}
	.panel-roots h3,
	.panel-roots .panel-icon { color: #fff; }
	.panel-roots p { color: rgba(255,255,255,0.85); max-width: 42ch; position: relative; z-index: 1; }
	.dots {
		position: absolute;
		top: 0; right: 0;
		width: 50%; height: 100%;
		background-image: radial-gradient(rgba(255,255,255,0.15) 2px, transparent 2px);
		background-size: 20px 20px;
	}

	/* panel-comm: surface */
	.panel-comm {
		background: var(--surface-container-lowest);
		color: var(--on-surface);
	}
	:root.theme-dark .panel-comm { background: var(--surface-container); }
	.panel-comm p { color: var(--on-surface-variant); }
	.circles {
		display: flex;
		margin-top: auto;
		padding-top: 1.5rem;
	}
	.circles span {
		width: 36px; height: 36px;
		border-radius: 50%;
		border: 3px solid var(--canvas, #F3F1FC);
		margin-left: -8px;
	}
	.circles span:first-child { margin-left: 0; }


	.cta-dark-card {
		background: #0f121d !important;
		color: #fff !important;
		border-color: #272a38 !important;
		display: grid;
		place-items: center;
		padding: 2.5rem !important;
		text-align: center;
	}

	.cta-dark-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2rem;
	}

	.cta-dark-content h3 {
		color: #fff !important;
		font-size: clamp(1.8rem, 3.5vw, 2.5rem) !important;
		line-height: 1.1 !important;
	}

	.stars-icon {
		font-size: 2rem;
	}

	.button-contact {
		display: inline-flex;
		padding: 0.65rem 1.25rem;
		border-radius: var(--radius-full);
		background: var(--primary);
		color: var(--on-primary);
		font-weight: 700;
		font-size: var(--text-sm);
		text-decoration: none;
		transition: background 0.3s;
	}

	.button-contact:hover {
		background: var(--chroma-ocean-strong);
	}

	@media (max-width: 49.99em) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
		.hero-art {
			justify-self: start;
		}
		.code-card {
			width: 280px;
		}
	}

	@media (min-width: 50em) {
		.think-head {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
		}

		.think-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.grow-grid {
			grid-template-columns: 1.2fr 1fr;
			gap: 3rem;
			align-items: stretch;
		}

		.grow-visual {
			min-height: 24rem;
		}

		.beyond-bento {
			grid-template-columns: repeat(3, 1fr);
		}

		.panel-art   { grid-column: span 2; }
		.panel-roots { grid-column: span 2; }

		.work-bento {
			grid-template-columns: 1.5fr 1fr;
			gap: 1.25rem;
		}

		/* slot-1: col 1 row 1 — horizontal (meta left, image right) */
		.slot-1 { grid-column: 1; grid-row: 1; }
		.slot-1 .work-card {
			flex-direction: row;
			min-height: 20rem;
		}
		.slot-1 .meta {
			flex: 0 0 52%;
			justify-content: center;
			padding: 2.2rem;
		}
		.slot-1 .img-container {
			flex: 1;
			min-height: 100%;
			position: relative;
		}

		/* slot-2: col 2 row 1 — vertical */
		.slot-2 { grid-column: 2; grid-row: 1; }
		.slot-2 .work-card { flex-direction: column; }
		.slot-2 .img-container {
			height: 12rem;
			width: 100%;
		}

		/* slot-3: full-width landscape — image left, meta right */
		.slot-3 { grid-column: 1 / -1; grid-row: 2; }
		.slot-3 .work-card {
			flex-direction: row;
			min-height: 18rem;
		}
		.slot-3 .img-container {
			flex: 1.1;
			min-height: 100%;
			position: relative;
		}
		.slot-3 .meta {
			flex: 1;
			justify-content: center;
			padding: 2.2rem;
		}

		/* slot-4: full-width CTA */
		.slot-4 { grid-column: 1 / -1; grid-row: 3; }

	}

	@media (min-width: 80em) {
		.hero-title {
			font-size: clamp(5rem, 6.5vw, 6.8rem);
		}

		.hero-tagline {
			max-width: 38ch;
			font-size: clamp(1.3rem, 1.9vw, 1.9rem);
		}

		.think {
			padding: 6.5rem 0;
		}

		.think-head h2,
		.grow-copy h2,
		.work-head h2,
		.beyond h2 {
			font-size: clamp(3.1rem, 4.6vw, 4.8rem);
		}

		.think-card {
			padding: 2.2rem;
		}

		.growing {
			padding-top: 6.5rem;
			padding-bottom: 6.5rem;
			gap: 5rem;
		}

		.grow-visual {
			min-height: 29rem;
		}

		.selected-work {
			padding: 7rem 0;
		}

		.work-card {
			padding: 1rem;
		}

		.work-card p {
			font-size: var(--text-lg);
			max-width: 44ch;
		}

		.slot-1 .img-container {
			height: 19rem;
		}

	}

	@media (min-width: 100em) {
		.home-page {
			--home-max: 88rem;
		}

		.hero {
			padding-top: 7.2rem;
			padding-bottom: 8rem;
		}

		.work-bento {
			gap: 1.35rem;
		}

		.slot-1 .img-container {
			height: 23rem;
		}

		.slot-3 .work-card {
			grid-template-columns: 1fr 0.85fr;
		}
	}

	:root.theme-dark .hero-tagline,
	:root.theme-dark .think-head p,
	:root.theme-dark .work-head p {
		color: #d6ddfb;
	}
	:root.theme-dark .think {
		background: #111633;
	}

	:root.theme-dark .think-card,
	:root.theme-dark .grow-tags span {
		background: #161c3b;
		border-color: rgba(121, 136, 208, 0.3);
		color: #eef3ff;
	}

	:root.theme-dark .think-card p {
		color: #d2dbfa;
	}

	:root.theme-dark .selected-work {
		background: #090c20;
	}

	:root.theme-dark .work-card {
		background: #171c3f;
		border-color: rgba(129, 146, 217, 0.35);
	}

	:root.theme-dark .work-card h3 {
		color: #f0f4ff;
	}

	:root.theme-dark .work-card p {
		color: #d0d9f7;
	}

	:root.theme-dark .work-card .tags span {
		background: rgba(169, 199, 255, 0.22);
		color: #e0ebff;
	}

	:root.theme-dark .slot-1 .work-card,
	:root.theme-dark .slot-2 .work-card,
	:root.theme-dark .slot-3 .work-card {
		background: #171c3f;
	}


	/* ── Community ── */
	.community {
		padding-top: 5.5rem;
		padding-bottom: 5.5rem;
		position: relative;
		overflow: hidden;
	}

	.comm-head {
		margin-bottom: 3rem;
	}

	.comm-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.comm-card {
		border-radius: 1.5rem;
		padding: 2.2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		transition: transform 0.3s var(--ease-expressive);
	}

	.comm-card:hover { transform: translateY(-4px); }

	.comm-card-top {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.comm-card-footer {
		margin-top: 1.5rem;
	}

	.comm-role {
		display: inline-block;
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		align-self: flex-start;
	}

	.comm-card h3 {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		line-height: 1.0;
		letter-spacing: -0.03em;
	}

	.comm-card p {
		font-size: var(--text-base);
		line-height: 1.65;
	}

	/* Primary — GitTogether — dark space navy + purple */
	.comm-primary {
		background: linear-gradient(135deg, #0D1117 0%, #1B1040 100%);
		color: #fff;
		min-height: 280px;
	}

	.comm-primary .comm-role {
		background: rgba(139, 92, 246, 0.25);
		color: #c4b5fd;
		border: 1px solid rgba(139, 92, 246, 0.35);
	}

	.comm-primary h3 { color: #fff; }
	.comm-primary p { color: rgba(255,255,255,0.78); }

	/* Secondary — Devs to Eternal — indigo periwinkle */
	.comm-secondary {
		background: linear-gradient(135deg, #6B7BF7 0%, #5B3CF5 100%);
		color: #fff;
		min-height: 280px;
		border: none;
	}

	.comm-secondary h3 { color: #fff; }

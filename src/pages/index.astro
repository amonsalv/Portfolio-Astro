---
import { getCollection, type CollectionEntry } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

// i18n
import { useTranslations } from '../utils/i18n';

// Content Fetching: List four most recent work projects (filter out Spanish versions to avoid duplicates)
const allProjects = await getCollection('work');
const projects = allProjects
	.filter((project: CollectionEntry<'work'>) => !project.slug.endsWith('-es'))
	.sort((a: CollectionEntry<'work'>, b: CollectionEntry<'work'>) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Default to English, will be updated by client-side script
const t = useTranslations('en');
---

<BaseLayout title="Ana Monsalve | Creative Developer">
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title={`${t.home.greeting} Ana Monsalve.`}
					tagline={`${t.home.description}`}
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> <span data-translate="developer">Developer</span></Pill>
						<!-- <Pill><Icon icon="microphone-stage" size="1.33em" /> Speaker</Pill> -->
						<Pill><Icon icon="pencil-line" size="1.33em" /> <span data-translate="writer">Writer</span></Pill>
					</div>
				</Hero>

				<!--imagen y descripcion de la imagen-->
				<!-- <img
					alt="Ana Monsalve"
					width="480"
					height="620"
					
				/> -->
				<!-- src="/assets/portrait.jpg" -->
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3 data-translate="selectedWork">Selected Work</h3>
					<p data-translate="workDescription">Take a look below at some of my featured work for clients from the past few years.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							// @ts-ignore
							projects.map((project) => {
								// Create corresponding Spanish project slug
								const spanishSlug = `${project.slug}-es`;
								// @ts-ignore
								const spanishProject = allProjects.find((p) => p.slug === spanishSlug);
								
								return (
									<li class="project-item" data-en-slug={project.slug} data-es-slug={spanishSlug}>
										<div class="project-en" style="display: block;">
											<PortfolioPreview project={project} />
										</div>
										{spanishProject && (
											<div class="project-es" style="display: none;">
												<PortfolioPreview project={spanishProject} />
											</div>
										)}
									</li>
								);
							})
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						<span data-translate="viewAll">View All</span>
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<!--<section class="section with-background bg-variant">-->
			<!--	<header class="section-header stack gap-2 lg:gap-4">-->
			<!--		<h3>Mentions</h3>-->
			<!--		<p>-->
			<!--			I have been fortunate enough to receive praise for my work in several publications. Take-->
			<!--			a look below to learn more.-->
			<!--		</p>-->
			<!--	</header>-->

			<!--	<div class="gallery">-->
			<!--		<Grid variant="small">-->
			<!--			{-->
			<!--				['Medium', 'BuzzFeed', 'The Next Web', 'awwwards.', 'TechCrunch'].map((brand) => (-->
			<!--					<li class="mention-card">-->
			<!--						<p>{brand}</p>-->
			<!--					</li>-->
			<!--				))-->
			<!--			}-->
			<!--		</Grid>-->
			<!--	</div>-->
			<!--</section>-->
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.css') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>

<script>
// Simple language update functionality
const translations = {
	en: {
		greeting: 'Hello, my name is',
		description: 'I am a Creative Developer who is currently based in Medellin, Colombia.',
		developer: 'Developer',
		writer: 'Writer',
		selectedWork: 'Selected Work',
		workDescription: 'Take a look below at some of my featured work for clients from the past few years.',
		viewAll: 'View All',
		// Skills section
		webDeveloper: 'Web Developer',
		webDeveloperDesc: 'I create clean, dynamic websites and stay updated with the latest frameworks to ensure modern, efficient designs.',
		devOps: 'DevOps',
		devOpsDesc: 'I excel at implementing efficient solutions, managing deployments, and ensuring security to maximize project value.',
		community: 'Community',
		communityDesc: 'I appreciate tech communities\' support and actively promote local events. I also serve as an organizer for two developer communities in my city, helping to coordinate meetups, workshops and networking opportunities.',
		// Contact CTA
		contactTitle: 'Interested in working together?',
		contactCta: 'Send Me a Message',
	},
	es: {
		greeting: 'Hola, mi nombre es',
		description: 'Soy una Desarrolladora Creativa que actualmente vive en Medellín, Colombia.',
		developer: 'Desarrolladora',
		writer: 'Escritora', 
		selectedWork: 'Trabajo Seleccionado',
		workDescription: 'Echa un vistazo a algunos de mis trabajos destacados para clientes de los últimos años.',
		viewAll: 'Ver Todo',
		// Skills section
		webDeveloper: 'Desarrolladora Web',
		webDeveloperDesc: 'Creo sitios web limpios y dinámicos, manteniéndome actualizada con los últimos frameworks para asegurar diseños modernos y eficientes.',
		devOps: 'DevOps',
		devOpsDesc: 'Sobresalgo implementando soluciones eficientes, gestionando despliegues y asegurando la seguridad para maximizar el valor del proyecto.',
		community: 'Comunidad',
		communityDesc: 'Aprecio el apoyo de las comunidades tecnológicas y promuevo activamente eventos locales. También soy organizadora de dos comunidades de desarrolladores en mi ciudad, ayudando a coordinar meetups, talleres y oportunidades de networking.',
		// Contact CTA
		contactTitle: '¿Interesada en trabajar juntas?',
		contactCta: 'Envíame un Mensaje',
	}
};

// @ts-ignore - Parameter type inferred from usage
function updatePageLanguage(language) {
	// Use direct object access to avoid TypeScript indexing issues
	let t;
	if (language === 'es') {
		t = translations.es;
	} else {
		t = translations.en;
	}
	
	// Update hero content
	const heroTitle = document.querySelector('h1');
	if (heroTitle) {
		heroTitle.textContent = `${t.greeting} Ana Monsalve.`;
	}
	
	const heroTagline = document.querySelector('.tagline');
	if (heroTagline) {
		heroTagline.textContent = t.description;
	}
	
	// Update specific elements by data-translate attribute
	const elements = {
		developer: t.developer,
		writer: t.writer,
		selectedWork: t.selectedWork,
		workDescription: t.workDescription,
		viewAll: t.viewAll,
		// Skills section
		webDeveloper: t.webDeveloper,
		webDeveloperDesc: t.webDeveloperDesc,
		devOps: t.devOps,
		devOpsDesc: t.devOpsDesc,
		community: t.community,
		communityDesc: t.communityDesc,
		// Contact CTA
		contactTitle: t.contactTitle,
		contactCta: t.contactCta,
	};
	
	Object.entries(elements).forEach(([key, value]) => {
		const element = document.querySelector(`[data-translate="${key}"]`);
		if (element) {
			element.textContent = value;
		}
	});

	// Switch project versions in Selected Work section
	const projectItems = document.querySelectorAll('.project-item');
	projectItems.forEach((item) => {
		const enVersion = item.querySelector('.project-en') as HTMLElement;
		const esVersion = item.querySelector('.project-es') as HTMLElement;
		
		if (language === 'es') {
			if (enVersion) enVersion.style.display = 'none';
			if (esVersion) esVersion.style.display = 'block';
		} else {
			if (enVersion) enVersion.style.display = 'block';
			if (esVersion) esVersion.style.display = 'none';
		}
	});
}

// Listen for language changes from LanguageToggle component
window.addEventListener('languageChange', (e) => {
	// @ts-ignore - Custom event from LanguageToggle component
	updatePageLanguage(e.detail.language);
});

// Initialize with saved language or browser preference
const savedLanguage = localStorage.getItem('language');
const initialLanguage = savedLanguage || (navigator.language.startsWith('es') ? 'es' : 'en');
if (initialLanguage === 'es') {
	updatePageLanguage('es');
}
</script>


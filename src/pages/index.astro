<script>
	const homeTranslations = {
		en: {
			heroTitle: "<span class='line-greeting'>¡Hola!</span><span class='line-name'>I'm <em>Ana.</em></span>",
			heroTagline: "I build technology with <em class='tint'>intention.</em> Combining the logic of code with the soul of a painter.",
			heroCta: 'View Selected Work',
			thinkTitle: 'How I think',
			thinkSubtitle: "My philosophy isn't just about output; it's about the process behind every pixel and line.",
			thinkCuriosityTitle: 'Curiosity',
			thinkCuriosityDesc: 'I approach every challenge like a blank canvas, asking the right questions before mixing the colors.',
			thinkLogicTitle: 'Logic',
			thinkLogicDesc: 'Structured systems and scalable architecture are the foundations that allow creativity to truly fly.',
			thinkPurposeTitle: 'Purpose',
			thinkPurposeDesc: 'I build for humans. Technology should solve real problems and carry intention.',
			growPill: 'Evolution',
			growTitle: "What I'm growing into",
			growDesc: "I'm currently obsessed with the infrastructure that makes great apps possible. Bridging the gap between code and deployment.",
			workTitle: 'Selected Work',
			workSubtitle: 'Take a look at some of my featured work for clients from the past few years.',
			workCtaCard: 'Ready for your next digital painting?',
			beyondTitle: 'Beyond the Code',
			beyondSubtitle: 'The fuel for my logical engine.',
			beyondPainting: 'Painting',
			beyondCrossfit: 'CrossFit',
			beyondGaming: 'Gaming',
			beyondWriting: 'Writing',
			beyondNature: 'Nature',
			ctaTitle: "Let's build something together",
			ctaDesc: "Whether it's a line of code or a stroke of color, I'm always looking for the next meaningful collaboration.",
			ctaButton: 'Get in touch',
		},
		es: {
			heroTitle: "<span class='line-greeting'>¡Hola!</span><span class='line-name'>Soy <em>Ana.</em></span>",
			heroTagline: "Construyo tecnología con <em class='tint'>intención.</em> Combinando la lógica del código con el alma de una pintora.",
			heroCta: 'Ver Trabajo Destacado',
			thinkTitle: 'Cómo pienso',
			thinkSubtitle: 'Mi filosofía no es solo sobre el resultado; es sobre el proceso detrás de cada píxel y línea.',
			thinkCuriosityTitle: 'Curiosidad',
			thinkCuriosityDesc: 'Abordo cada reto como un lienzo en blanco, haciendo las preguntas correctas antes de mezclar los colores.',
			thinkLogicTitle: 'Lógica',
			thinkLogicDesc: 'Los sistemas estructurados y la arquitectura escalable son la base que permite volar a la creatividad.',
			thinkPurposeTitle: 'Propósito',
			thinkPurposeDesc: 'Construyo para personas. La tecnología debe resolver problemas reales con intención.',
			growPill: 'Evolución',
			growTitle: 'En qué estoy creciendo',
			growDesc: 'Actualmente estoy obsesionada con la infraestructura que hace posibles las grandes apps. Cerrando la brecha entre código y despliegue.',
			workTitle: 'Trabajo Seleccionado',
			workSubtitle: 'Mira algunos de mis trabajos destacados para clientes de los últimos años.',
			workCtaCard: '¿Listo para tu próxima pintura digital?',
			beyondTitle: 'Más Allá del Código',
			beyondSubtitle: 'El combustible de mi motor lógico.',
			beyondPainting: 'Pintura',
			beyondCrossfit: 'CrossFit',
			beyondGaming: 'Videojuegos',
			beyondWriting: 'Escritura',
			beyondNature: 'Naturaleza',
			ctaTitle: 'Construyamos algo juntas',
			ctaDesc: 'Ya sea una línea de código o un trazo de color, siempre busco la próxima colaboración significativa.',
			ctaButton: 'Escríbeme',
		},
	};

	function updateHomeLanguage(language: string) {
		const t = language === 'es' ? homeTranslations.es : homeTranslations.en;
		Object.entries(t).forEach(([key, value]) => {
			const elements = document.querySelectorAll(`[data-translate="${key}"]`);
			elements.forEach((el) => {
				if (key === 'heroTitle' || key === 'heroTagline') {
					el.innerHTML = value;
				} else {
					el.textContent = value;
				}
			});
		});

		const projectItems = document.querySelectorAll('.project-item');
		projectItems.forEach((item) => {
			const en = item.querySelector('.project-en') as HTMLElement | null;
			const es = item.querySelector('.project-es') as HTMLElement | null;
			if (language === 'es') {
				if (en) en.style.display = 'none';
				if (es) es.style.display = 'block';
			} else {
				if (en) en.style.display = 'block';
				if (es) es.style.display = 'none';
			}
		});
	}

	window.addEventListener('languageChange', (e) => {
		// @ts-ignore
		updateHomeLanguage(e.detail.language);
	});

	const saved = localStorage.getItem('language');
	const init = saved || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (init === 'es') updateHomeLanguage('es');
</script>


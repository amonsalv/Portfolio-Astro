---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const allProjects = await getCollection('work');
const projects = allProjects
	.filter((project: CollectionEntry<'work'>) => !project.id.includes('-es'))
	.sort(
		(a: CollectionEntry<'work'>, b: CollectionEntry<'work'>) =>
			b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
	)
	.slice(0, 3);
---

<BaseLayout title="Ana Monsalve | Developer & Painter">
	<main class="home-page">
		<section class="hero">
			<div class="blur blur-a" aria-hidden="true"></div>
			<div class="blur blur-b" aria-hidden="true"></div>
			<div class="hero-content">
				<h1 class="hero-title" data-translate="heroTitle">
					<span class="line-greeting">¡Hola!</span>
					<span class="line-name">I'm <em>Ana.</em></span>
				</h1>
				<p class="hero-tagline" data-translate="heroTagline">
					I build technology with <em class="tint">intention.</em> Combining the logic of code with the soul of a painter.
				</p>
				<a class="hero-cta" href="/work/" data-translate="heroCta">View Selected Work</a>
			</div>
		</section>

		<section class="think">
			<div class="wrapper think-inner">
				<div class="think-head">
					<h2 data-translate="thinkTitle">How I think</h2>
					<p data-translate="thinkSubtitle">My philosophy isn't just about output; it's about the process behind every pixel and line.</p>
				</div>
				<div class="think-grid">
					<article class="think-card curiosity">
						<div class="icon">✦</div>
						<h3 data-translate="thinkCuriosityTitle">Curiosity</h3>
						<p data-translate="thinkCuriosityDesc">I approach every challenge like a blank canvas, asking the right questions before mixing the colors.</p>
					</article>
					<article class="think-card logic">
						<div class="icon">▦</div>
						<h3 data-translate="thinkLogicTitle">Logic</h3>
						<p data-translate="thinkLogicDesc">Structured systems and scalable architecture are the foundations that allow creativity to truly fly.</p>
					</article>
					<article class="think-card purpose">
						<div class="icon">◎</div>
						<h3 data-translate="thinkPurposeTitle">Purpose</h3>
						<p data-translate="thinkPurposeDesc">I build for humans. Technology should solve real problems and carry intention.</p>
					</article>
				</div>
			</div>
		</section>

		<section class="growing wrapper">
			<div class="grow-copy">
				<p class="grow-pill" data-translate="growPill">Evolution</p>
				<h2 data-translate="growTitle">What I'm growing into</h2>
				<p data-translate="growDesc">I'm currently obsessed with the infrastructure that makes great apps possible. Bridging the gap between code and deployment.</p>
				<div class="grow-tags">
					<span class="tag-cloud"><Icon icon="cloud" size="1.2em" /> Cloud Computing</span>
					<span class="tag-devops"><Icon icon="gear" size="1.2em" /> DevOps</span>
					<span class="tag-auto"><Icon icon="lightning" size="1.2em" /> Automation</span>
				</div>
			</div>
			<div class="grow-art" aria-hidden="true">
				<svg class="star-icon star-1" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
				</svg>
				<svg class="star-icon star-2" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
				</svg>
				<svg class="star-icon star-3" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
				</svg>
			</div>
		</section>

		<section class="selected-work">
			<div class="wrapper">
				<header class="work-head">
					<h2 data-translate="workTitle">Selected Work</h2>
					<p data-translate="workSubtitle">Take a look at some of my featured work for clients from the past few years.</p>
				</header>
				<ul class="work-bento">
					{
						projects.map((project, idx) => {
							const spanishId = project.id.includes('.md') ? project.id.replace('.md', '-es.md') : `${project.id}-es`;
							// @ts-ignore
							const spanishProject = allProjects.find((p) => p.id === spanishId || p.slug === `${project.slug}-es`);
							const slot = `slot-${idx + 1}`;
							return (
								<li class:list={['project-item', slot]} data-en-slug={project.id} data-es-slug={spanishId}>
									<div class="project-en" style="display: block;">
										<a class="work-card" href={`/work/${project.id}`}>
											<div class="meta">
												<div class="tags">
													{project.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
												</div>
												<h3>{project.data.title}</h3>
												<p>{project.data.description}</p>
												<span class="read-more" aria-hidden="true">View Case Study <Icon icon="arrow-right" size="1.2em" /></span>
											</div>
											<div class="img-container">
												<img src={project.data.img} alt={project.data.img_alt || ''} loading="lazy" decoding="async" />
											</div>
										</a>
									</div>
									{spanishProject && (
										<div class="project-es" style="display: none;">
											<a class="work-card" href={`/work/${spanishProject.id}`}>
												<div class="meta">
													<div class="tags">
														{spanishProject.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
													</div>
													<h3>{spanishProject.data.title}</h3>
													<p>{spanishProject.data.description}</p>
													<span class="read-more" aria-hidden="true">Ver Caso de Estudio <Icon icon="arrow-right" size="1.2em" /></span>
												</div>
												<div class="img-container">
													<img src={spanishProject.data.img} alt={spanishProject.data.img_alt || ''} loading="lazy" decoding="async" />
												</div>
											</a>
										</div>
									)}
								</li>
							);
						})
					}
					<li class="project-item slot-4">
						<div class="work-card cta-dark-card">
							<div class="cta-dark-content">
								<span class="stars-icon">✨</span>
								<h3 data-translate="workCtaCard">Ready for your next digital painting?</h3>
								<a href="mailto:hola@anamonsalve.com" class="button-contact" data-translate="ctaButton">Contact Ana</a>
							</div>
						</div>
					</li>
				</ul>
			</div>
		</section>

		<section class="beyond wrapper">
			<h2 data-translate="beyondTitle">Beyond the Code</h2>
			<p data-translate="beyondSubtitle">The fuel for my logical engine.</p>
			<div class="beyond-list">
				<div><span>🎨</span><span data-translate="beyondPainting">Painting</span></div>
				<div><span>🏋️</span><span data-translate="beyondCrossfit">CrossFit</span></div>
				<div><span>🎮</span><span data-translate="beyondGaming">Gaming</span></div>
				<div><span>✍️</span><span data-translate="beyondWriting">Writing</span></div>
				<div><span>🌊</span><span data-translate="beyondNature">Nature</span></div>
			</div>
		</section>

		<section class="home-cta-wrapper wrapper">
			<div class="home-cta">
				<div class="home-cta-inner">
					<h2 data-translate="ctaTitle">Let's build something together</h2>
					<p data-translate="ctaDesc">Whether it's a line of code or a stroke of color, I'm always looking for the next meaningful collaboration.</p>
					<a href="mailto:hola@anamonsalve.com" class="btn-cta">
						<span data-translate="ctaButton">Get in touch</span>
						<Icon icon="paper-plane-tilt" size="1.2em" />
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.home-page {
		display: flex;
		flex-direction: column;
		gap: 0;
		--home-max: min(84rem, 92vw);
	}

	.home-page .wrapper {
		max-width: var(--home-max);
		padding-inline: clamp(1.2rem, 3vw, 3rem);
		margin-inline: auto;
	}

	.hero {
		position: relative;
		padding-top: 5.2rem;
		padding-bottom: 7.5rem;
		overflow: hidden;
		max-width: 100%;
		padding-inline: clamp(1.2rem, 3vw, 3rem);
		background: linear-gradient(180deg, color-mix(in srgb, var(--surface-container-low) 60%, transparent) 0%, transparent 100%);
	}

	.hero-content {
		max-width: var(--home-max);
		margin-inline: auto;
	}

	.hero-title {
		font-size: clamp(3rem, 10vw, 7.2rem);
		line-height: 0.86;
		letter-spacing: -0.05em;
		margin-bottom: 1.3rem;
	}

	:global(.hero-title .line-greeting) {
		display: block;
		color: var(--on-surface);
	}

	:global(.hero-title .line-name) {
		display: block;
		color: var(--primary); /* All of "I'm Ana" is blue to match reference image exactly */
	}

	:global(.hero-title .line-name em) {
		font-style: normal;
	}

	.hero-tagline {
		max-width: 34ch;
		font-size: clamp(1.15rem, 2.3vw, 1.9rem);
		line-height: 1.45;
		color: var(--on-surface-variant);
	}
	
	.hero-tagline em.tint {
		font-style: italic;
		color: var(--tertiary);
	}

	.hero-cta {
		display: inline-flex;
		margin-top: 2rem;
		padding: 0.85rem 1.5rem;
		border-radius: var(--radius-full);
		font-weight: 800;
		background: var(--primary);
		color: var(--on-primary);
		box-shadow: 0 14px 30px rgba(21, 88, 214, 0.24);
	}

	.hero-cta:hover {
		color: var(--on-primary);
		background: var(--chroma-ocean-strong);
	}

	.blur {
		position: absolute;
		border-radius: 999px;
		filter: blur(80px);
		pointer-events: none;
		opacity: 0.8;
	}

	.blur-a {
		width: 40rem;
		height: 40rem;
		right: -8rem;
		top: -8rem;
		background: color-mix(in srgb, #5b9eff 70%, transparent); /* More saturated blue */
	}

	.blur-b {
		width: 15%;
		height: 35rem;
		left: -12rem;
		bottom: 0rem;
		background: color-mix(in srgb, #d4a574 65%, transparent); /* More saturated warm peach */
	}

	.think {
		background: var(--surface-container-low);
		padding: 5.5rem 0;
	}

	.think-head {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		margin-bottom: 2.2rem;
	}

	.think-head h2 {
		font-size: clamp(2.3rem, 5vw, 3.9rem);
	}

	.think-head p {
		max-width: 40ch;
		font-size: var(--text-lg);
		color: var(--on-surface-variant);
	}

	.think-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
	}

	.think-card {
		background: var(--surface-container-lowest);
		border-radius: 1rem;
		padding: 1.4rem;
		border-top: 6px solid transparent;
		box-shadow: var(--shadow-sm);
	}

	.think-card .icon {
		width: 2.4rem;
		height: 2.4rem;
		display: grid;
		place-items: center;
		font-size: 1.1rem;
		border-radius: 0.6rem;
		margin-bottom: 0.8rem;
	}

	.think-card h3 {
		font-size: 1.8rem;
		margin-bottom: 0.45rem;
	}

	.think-card p {
		color: var(--on-surface-variant);
		line-height: 1.5;
	}

	.think-card.curiosity {
		border-top: 3px solid #2563eb;
	}

	.think-card.curiosity .icon {
		background: color-mix(in srgb, var(--primary) 22%, transparent);
		color: var(--chroma-ocean-strong);
	}

	.think-card.logic {
		border-top: 3px solid #f59e0b;
	}

	.think-card.logic .icon {
		background: color-mix(in srgb, var(--chroma-sunny) 28%, transparent);
		color: #7a5200;
	}

	.think-card.purpose {
		border-top: 3px solid #10b981;
	}

	.think-card.purpose .icon {
		background: color-mix(in srgb, var(--tertiary) 18%, transparent);
		color: #8b2027;
	}

	.growing {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		padding-top: 5.5rem;
		padding-bottom: 5.5rem;
	}

	.grow-pill {
		display: inline-flex;
		padding: 0.35rem 0.9rem;
		border-radius: var(--radius-full);
		font-size: 0.74rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #ffffff !important;
		background: #a93c41;
		margin-bottom: 0.9rem;
	}

	:root.theme-dark .grow-pill {
		color: #ffffff !important;
		background: #8b3036;
	}

	.grow-copy h2 {
		font-size: clamp(2.2rem, 6vw, 4.3rem);
		line-height: 0.95;
		margin-bottom: 0.9rem;
	}

	.grow-copy p {
		max-width: 40ch;
		font-size: var(--text-lg);
		color: var(--on-surface-variant);
	}

	.grow-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	.grow-tags span {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.9rem;
		border-radius: 0.4rem;
		background: var(--surface-container);
		font-weight: 600;
		font-size: var(--text-sm);
	}
	
	.tag-cloud :global(svg) { color: #2563eb; }
	.tag-devops :global(svg) { color: #a93c41; }
	.tag-auto :global(svg) { color: #d97706; }

	.grow-art {
		position: relative;
		min-height: 18rem;
		border-radius: 1.2rem;
		background: linear-gradient(135deg, #9caaf2 0%, #ebd7d0 100%);
		overflow: hidden;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
	}

	:global([data-theme="dark"]) .grow-art {
		background: linear-gradient(135deg, #1e2540 0%, #3d2f2d 100%);
	}

	.star-icon {
		position: absolute;
		color: color-mix(in srgb, #ffffff 90%, transparent);
	}

	.star-1 {
		width: 7rem;
		height: 7rem;
		right: 30%;
		top: 50%;
		transform: translateY(-50%) rotate(15deg);
	}

	.star-2 {
		width: 3.5rem;
		height: 3.5rem;
		right: 15%;
		top: 32%;
		transform: rotate(-10deg);
	}

	.star-3 {
		width: 3rem;
		height: 3rem;
		right: 22%;
		bottom: 25%;
		transform: rotate(5deg);
	}

	.selected-work {
		background: var(--surface-container);
		padding: 5.2rem 0;
	}

	.work-head {
		margin-bottom: 3rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.work-head h2 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		line-height: 0.9;
		margin-bottom: 0.8rem;
	}

	.work-head p {
		font-size: var(--text-xl);
		max-width: 45ch;
		color: var(--on-surface-variant);
	}

	.work-bento {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.work-card {
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
		padding: 2.2rem;
		border-radius: 1.5rem;
		background: var(--surface-container-lowest);
		box-shadow: 0 4px 20px rgba(0,0,0,0.03);
		text-decoration: none;
		color: inherit;
		border: none;
		transition: transform 0.3s var(--ease-expressive), box-shadow 0.3s var(--ease-expressive);
	}

	.work-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 15px 35px rgba(0,0,0,0.08);
	}

	:global([data-theme="dark"]) .work-card {
		background: var(--surface-container);
		box-shadow: none;
		border: 1px solid var(--surface-container-high);
	}

	.slot-1 .work-card {
		background: #ffffff;
		min-height: 22rem;
	}
	:global([data-theme="dark"]) .slot-1 .work-card { background: var(--surface-container); }

	.slot-2 .work-card {
		background: #ffffff;
		min-height: 20rem;
		flex-direction: column-reverse; /* Mobiles: pic on top */
	}
	:global([data-theme="dark"]) .slot-2 .work-card { background: var(--surface-container); }

	.slot-3 .work-card {
		background: #ffffff;
		min-height: 20rem;
	}
	:global([data-theme="dark"]) .slot-3 .work-card { background: var(--surface-container); }

	.work-card .meta {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		z-index: 2;
	}

	.work-card .tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.3rem;
	}

	.work-card .tags span {
		padding: 0.3rem 0.8rem;
		border-radius: var(--radius-full);
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.slot-1 .tags span { background: #dce7ff; color: #1e3a8a; }
	.slot-2 .tags span { background: #ffc0b3; color: #9f1239; }
	.slot-3 .tags span { background: #ffe4c4; color: #92400e; }

	:global([data-theme="dark"]) .slot-1 .tags span { background: #1e3a8a; color: #dce7ff; }
	:global([data-theme="dark"]) .slot-2 .tags span { background: #9f1239; color: #ffc0b3; }
	:global([data-theme="dark"]) .slot-3 .tags span { background: #92400e; color: #ffe4c4; }

	.slot-1 .meta { max-width: 65%; }
	.slot-1 .img-container {
		position: absolute;
		right: -3rem;
		bottom: -3rem;
		width: 20rem;
		height: 20rem;
		border-radius: 50%;
		background: #ebf2fa;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	:global([data-theme="dark"]) .slot-1 .img-container { background: #1a2332; }

	.slot-1 .img-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		opacity: 0.95;
		mix-blend-mode: multiply;
	}
	:global([data-theme="dark"]) .slot-1 .img-container img { mix-blend-mode: normal; } 

	.slot-2 .img-container {
		width: 14rem;
		height: 14rem;
		border-radius: 50%;
		border: 12px solid #ffffff;
		box-shadow: 0 15px 35px rgba(0,0,0,0.1);
		overflow: hidden;
		flex-shrink: 0;
		margin-bottom: 1.5rem;
		margin-inline: auto;
	}
	:global([data-theme="dark"]) .slot-2 .img-container { border-color: var(--surface); }

	.slot-3 .meta { margin-bottom: 1.5rem; }
	.slot-3 .img-container {
		width: 100%;
		flex-grow: 1;
		border-radius: 1rem;
		overflow: hidden;
		min-height: 15rem;
	}

	.work-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--theme-transition);
	}

	.work-card:focus-within img,
	.work-card:hover img {
		transform: scale(1.05);
	}

	.work-card h3 {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		line-height: 1.1;
		color: var(--on-surface);
		letter-spacing: -0.03em;
	}

	.work-card p {
		font-size: var(--text-base);
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.read-more {
		display: none;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.5rem;
		font-weight: 700;
		font-size: 0.95rem;
		color: #2563eb;
	}
	:global([data-theme="dark"]) .read-more { color: #60a5fa; }
	.slot-1 .read-more { display: inline-flex; }

	.beyond {
		padding-top: 5rem;
		padding-bottom: 5rem;
		text-align: center;
	}

	.beyond h2 {
		font-size: clamp(2.4rem, 5vw, 4.4rem);
		margin-bottom: 0.5rem;
	}

	.beyond p {
		font-size: var(--text-lg);
		color: var(--on-surface-variant);
		margin-bottom: 1.5rem;
	}

	.beyond-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
	}

	.beyond-list div {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.7rem 1.4rem;
		border-radius: 0.8rem;
		background: var(--surface-container-low);
		font-weight: 700;
		color: var(--on-surface);
	}

	.home-cta-wrapper {
		padding-top: 2rem;
		padding-bottom: 5rem;
	}

	.home-cta {
		position: relative;
		overflow: hidden;
		background: var(--primary);
		color: #ffffff;
		text-align: center;
		padding: 4.5rem 1.5rem;
		border-radius: 2rem;
		box-shadow: 0 20px 40px rgba(0,0,0,0.08);
	}

	.home-cta::before,
	.home-cta::after {
		content: '';
		position: absolute;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		pointer-events: none;
	}

	.home-cta::before {
		width: 18rem;
		height: 18rem;
		left: -6rem;
		top: -6rem;

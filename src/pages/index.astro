	function updateHomeLanguage(language: string) {
		const t = language === 'es' ? homeTranslations.es : homeTranslations.en;
		Object.entries(t).forEach(([key, value]) => {
			const elements = document.querySelectorAll(`[data-translate="${key}"]`);
			elements.forEach((el) => {
				if (key === 'heroTitle' || key === 'heroTagline') {
					el.innerHTML = value;
				} else {
					el.textContent = value;
				}
			});
		});

		const projectItems = document.querySelectorAll('.project-item');
		projectItems.forEach((item) => {
			const en = item.querySelector('.project-en') as HTMLElement | null;
			const es = item.querySelector('.project-es') as HTMLElement | null;
			if (language === 'es') {
				if (en) en.style.display = 'none';
				if (es) es.style.display = 'block';
			} else {
				if (en) en.style.display = 'block';
				if (es) es.style.display = 'none';
			}
		});
	}

	window.addEventListener('languageChange', (e) => {
		updateHomeLanguage(e.detail.language);
	});

	const saved = localStorage.getItem('language');
	const init = saved || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (init === 'es') updateHomeLanguage('es');
</script>


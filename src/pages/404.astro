---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Página no encontrada | Ana Monsalve" description="Esta página no existe.">
	<main class="not-found wrapper">
		<div class="nf-inner">
			<span class="nf-code" aria-hidden="true">404</span>
			<div class="nf-content">
				<span class="sec-label">Error</span>
				<h1 class="nf-title">Página no encontrada</h1>
				<p class="nf-desc">
					Parece que esta URL no existe — o fue movida. Vuelve al inicio y encuentra lo que buscas.
				</p>
				<div class="nf-actions">
					<a href="/" class="nf-btn-primary">← Volver al inicio</a>
					<a href="/work/" class="nf-btn-ghost">Ver proyectos</a>
				</div>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found {
		min-height: calc(100svh - 120px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: 4rem;
	}

	.nf-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		max-width: 42rem;
	}

	/* Large decorative 404 */
	.nf-code {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 300;
		font-size: clamp(6rem, 20vw, 14rem);
		line-height: 1;
		letter-spacing: -0.05em;
		color: color-mix(in srgb, var(--chroma-ocean) 12%, transparent);
		user-select: none;
		pointer-events: none;
		position: absolute;
		top: -1rem;
		left: -1rem;
	}

	.nf-content {
		position: relative;
		z-index: 1;
		padding-top: clamp(5rem, 12vw, 9rem);
	}

	.nf-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin: 0.75rem 0 1.25rem;
		color: var(--on-surface);
	}

	.nf-desc {
		font-size: 1.05rem;
		color: var(--on-surface-variant);
		line-height: 1.65;
		max-width: 40ch;
		margin-bottom: 2rem;
	}

	.nf-actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.nf-btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		background: var(--chroma-ocean);
		color: #fff;
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		transition: background 0.2s, transform 0.2s;
	}

	.nf-btn-primary:hover {
		background: var(--chroma-ocean-strong);
		color: #fff;
		transform: translateY(-1px);
	}

	.nf-btn-ghost {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		background: transparent;
		color: var(--on-surface-variant);
		border: 1.5px solid var(--outline-variant);
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		transition: border-color 0.2s, color 0.2s;
	}

	.nf-btn-ghost:hover {
		border-color: var(--on-surface);
		color: var(--on-surface);
	}
</style>

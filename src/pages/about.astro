---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { useTranslations } from '../utils/i18n';

// Default to English, will be updated by client-side script
const t = useTranslations('en');
---

<BaseLayout title="About | Ana Monsalve" description="About Ana Monsalve Developer">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Ana Monsalve"
				tagline={t.about.heroTagline}
			>
			<!-- src="/assets/at-work.jpg" -->
				<!-- <img
					width="1553"
					height="873"
					
					alt="Ana Monsalve at work with a colleague"
				/> -->
			</Hero>

			<section>
				<h2 class="section-title" data-translate="backgroundTitle">Background</h2>
				<div class="content">
					<p data-translate="backgroundText">
						Software developer with experience in application creation, system architecture, and digital process improvement. I work with technologies like Node.js, React, Angular, Python, and Docker. I stand out for problem-solving, collaboration, and results orientation.
					</p>
				</div>
			</section>

			<section>
				<h2 class="section-title" data-translate="experienceTitle">Professional Experience</h2>
				
				<div class="content">
					<h5 data-translate="luppiterTitle">Luppiter - Software Development and DevOps Consultant</h5>
					<p data-translate="luppiterLocation">Medellín, Colombia</p>
					<p data-translate="luppiterDate">July 2024 - April 2025</p>
					<ul data-translate="luppiterDesc">
						<li>Participated in software requirements gathering and analysis for various projects.</li>
						<li>Implemented DevOps practices focused on more efficient integration and deployments.</li>
						<li>Developed and optimized automations to improve internal processes and reduce delivery times.</li>
					</ul>
				</div>

				<div class="content">
					<h5 data-translate="cesdeDevTitle">Cesde Institución Educativa - Software Developer</h5>
					<p data-translate="cesdeDevLocation">Medellín, Colombia</p>
					<p data-translate="cesdeDevDate">July 2023 - May 2024</p>
					<ul data-translate="cesdeDevDesc">
						<li>Developed web applications with backend focus (Node.js, Python).</li>
						<li>Optimized databases with MongoDB, Firebase, and SQL Server.</li>
						<li>Implemented task automation and managed projects in Jira.</li>
						<li>Created applications with AppSheet and performed quality testing.</li>
					</ul>
				</div>

				<div class="content">
					<h5 data-translate="grupoUribeTitle">Grupo Uribe (GCO) - Software Development Intern</h5>
					<p data-translate="grupoUribeLocation">Medellín, Colombia</p>
					<p data-translate="grupoUribeDate">July 2022 - December 2022</p>
					<ul data-translate="grupoUribeDesc">
						<li>Store support through scheduling platform, improving operational efficiency.</li>
						<li>Generated biweekly reports in Excel, optimizing time control by 15%.</li>
						<li>Improved platform usability by 20% with HTML and JavaScript.</li>
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title" data-translate="freelanceTitle">Freelance Experience / Service Projects</h2>
				
				<div class="content">
					<h5 data-translate="invoiceAutomationTitle">Invoice Automation Refactoring - Freelance</h5>
					<p data-translate="invoiceAutomationLocation">Medellín, Colombia</p>
					<p data-translate="invoiceAutomationDate">February 2025 - April 2025</p>
					<p data-translate="invoiceAutomationDesc">Refactored automation processes with Selenium, optimizing invoice forwarding to a Linux server.</p>
				</div>

				<div class="content">
					<h5 data-translate="lowCodeTitle">Low-Code Projects - Freelance</h5>
					<p data-translate="lowCodeLocation">Medellín, Colombia</p>
					<p data-translate="lowCodeDate">October - December 2024</p>
					<p data-translate="lowCodeDesc">Created applications with Codenull (low-code) and administered databases, facilitating information management.</p>
				</div>

				<div class="content">
					<h5 data-translate="internalAutomationTitle">Internal Automations - Freelance</h5>
					<p data-translate="internalAutomationLocation">Medellín, Colombia</p>
					<p data-translate="internalAutomationDate">May 2024 - July 2024</p>
					<p data-translate="internalAutomationDesc">Developed automations with Selenium and Python in a Windows Server environment, improving internal process efficiency.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title" data-translate="educationTitle">Education</h2>
				<div class="content">
				  <h5 data-translate="cesdeInstitution">Cesde Institución Educativa</h5>
				  <p data-translate="cesdeDegree">Technical Assistant in Software Development</p>
				  <p data-translate="cesdeLocation">Medellín, Colombia</p>
				  <p data-translate="cesdeGraduation">Graduated: September 2023</p>
				</div>
				<div class="content">
				  <h5 data-translate="senaInstitution">Servicio Nacional de Aprendizaje (SENA)</h5>
				  <p data-translate="senaDegree">Technology in Software Analysis and Development</p>
				  <p data-translate="senaLocation">Medellín, Colombia</p>
				  <p data-translate="senaGraduation">July 2024 - Present</p>
				</div>
			  </section>
			<section>
				<h2 class="section-title" data-translate="skillsTitle">Additional Skills</h2>
				<div class="content">
					<h5 data-translate="webDevTitle">Web Development</h5>
					<p data-translate="webDevDesc">Node.js, Python, Astro, React, HTML, JavaScript</p>
				  </div>
				  <div class="content">
					<h5 data-translate="databaseTitle">Databases</h5>
					<p data-translate="databaseDesc">MongoDB, Firebase, SQL Server</p>
				  </div>
				  <div class="content">
					<h5 data-translate="devopsTitle">DevOps and Automation</h5>
					<p data-translate="devopsDesc">Docker, GitHub Actions</p>
				  </div>
				  <div class="content">
					<h5 data-translate="projectMgmtTitle">Project Management</h5>
					<p data-translate="projectMgmtDesc">Jira</p>
				  </div>
				  <div class="content">
					<h5 data-translate="lowcodeTitle">Low-code Applications</h5>
					<p data-translate="lowcodeDesc">AppSheet, Codenull</p>
				  </div>
				</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>

	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	.content ul {
		margin: 0.5rem 0;
		padding-left: 1.5rem;
	}

	.content li {
		margin: 0.25rem 0;
		color: var(--gray-200);
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>

<script>

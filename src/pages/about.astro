---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="About | Ana Monsalve" description="Ana Monsalve — Software Development Apprentice at NTT DATA, automation engineer, and artist from Medellín.">
	<div class="stack gap-20">
		<main class="about-page wrapper">
			<section class="about-hero">
				<div class="hero-copy stack gap-3">
					<p class="eyebrow" data-translate="aboutEyebrow">Software Development Apprentice @ NTT DATA · Artist</p>
					<h1>
						<span class="about-l1" data-translate="aboutTitleL1">The logic of code.</span>
						<span class="about-l2" data-translate="aboutTitleL2">The soul of paint.</span>
					</h1>
					<p class="hero-desc" data-translate="aboutDescription">
						I'm Ana — a developer and automation engineer who treats every system like a composition. I care as much about how something feels as whether it ships.
					</p>
				</div>
				<div class="hero-art" aria-hidden="true">
					<div class="art-frame">
						<div class="art-frame-inner">
							<svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.4" width="80" height="80" aria-hidden="true">
								<path d="M12 19l7-7 3 3-7 7-3-3z"/>
								<path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
								<path d="M2 2l7.586 7.586"/>
								<circle cx="11" cy="11" r="2"/>
							</svg>
						</div>
					</div>
				</div>
			</section>

			<section class="mission-card reveal">
				<span class="qmark" aria-hidden="true">"</span>
				<h2 data-translate="missionTitle">Why I do what I do</h2>
				<blockquote data-translate="missionQuote">I build technology with intention — bridging the precision of engineering and the warmth of craft, so the things I make actually mean something to the people who use them.</blockquote>
			</section>

			<section class="toolbox stack gap-4" style="position:relative; overflow:hidden;">
				<span class="sec-numeral sec-numeral-right" aria-hidden="true">01</span>
				<div class="sec-head reveal">
					<span class="sec-label">01 — Toolbox</span>
					<h2 class="section-title" data-translate="toolboxTitle">Technical Toolbox</h2>
				</div>
				<div class="toolbox-grid reveal" data-stagger>
					<article class="tool-card frontend">
						<div class="tool-card-header">
							<Icon icon="pencil-line" size="1.4em" />
							<h3>Frontend</h3>
						</div>
						<div class="chips">
							<span>React</span><span>Angular</span><span>Astro</span><span>JavaScript</span><span>HTML</span><span>CSS</span><span>TypeScript</span>
						</div>
					</article>
					<article class="tool-card backend">
						<div class="tool-card-header">
							<Icon icon="database" size="1.4em" />
							<h3>Backend</h3>
						</div>
						<div class="chips">
							<span>Node.js</span><span>Python</span><span>REST APIs</span><span>MongoDB</span><span>Firebase</span><span>SQL Server</span>
						</div>
					</article>
					<article class="tool-card automation">
						<div class="tool-card-header">
							<Icon icon="gear" size="1.4em" />
							<h3>Automation & DevOps</h3>
						</div>
						<div class="chips">
							<span>Selenium</span><span>Docker</span><span>GitHub Actions</span><span>CI/CD</span><span>Linux</span><span>Windows Server</span>
						</div>
					</article>
					<article class="tool-card tools">
						<div class="tool-card-header">
							<Icon icon="wrench" size="1.4em" />
							<h3>Tools & Platforms</h3>
						</div>
						<div class="chips">
							<span>Git</span><span>Jira</span><span>AppSheet</span><span>Codenull</span>
						</div>
					</article>
				</div>
			</section>

			<section class="journey stack gap-4" style="position:relative; overflow:hidden;">
				<span class="sec-numeral sec-numeral-left" aria-hidden="true">02</span>
				<div class="sec-head reveal">
					<span class="sec-label">02 — Journey</span>
					<h2 class="section-title" data-translate="journeyTitle">The Journey</h2>
				</div>
				<div class="timeline reveal" data-stagger>
					<article class="timeline-item left accent-primary">
						<p class="period" data-translate="journeyDateZero">Aug 2026 &mdash; Present</p>
						<h3 data-translate="journeyJobZero">Software Development Apprentice</h3>
						<p class="company" data-translate="journeyCompZero">NTT DATA Colombia &mdash; Medellín, Colombia</p>
						<p class="desc" data-translate="journeyDescZero">Starting a new chapter as a Software Development Apprentice, contributing to real-world projects while continuing to grow as a technologist.</p>
					</article>
					<article class="timeline-item right accent-secondary">
						<p class="period" data-translate="journeyDateOne">May 2024 &mdash; Jan 2026</p>
						<h3 data-translate="journeyJobOne">Freelance Software Dev & DevOps Consultant</h3>
						<p class="company" data-translate="journeyCompOne">Luppiter &mdash; Medellín, Colombia</p>
						<p class="desc" data-translate="journeyDescOne">Freelance consultant designing automation pipelines and DevOps workflows for small product teams — turning manual processes into reliable, observable systems, with low-code tools (AppSheet, Codenull) across Linux and Windows Server.</p>
					</article>
					<article class="timeline-item left accent-tertiary">
						<p class="period" data-translate="journeyDateTwo">Jul 2023 &mdash; May 2024</p>
						<h3 data-translate="journeyJobTwo">Software Developer</h3>
						<p class="company" data-translate="journeyCompTwo">Cesde Institución Educativa &mdash; Medellín, Colombia</p>
						<p class="desc" data-translate="journeyDescTwo">Built and maintained internal web tools with Node.js and Python, designing databases across MongoDB, Firebase, and SQL Server, and automating technical processes — project-managed through Jira.</p>
					</article>
					<article class="timeline-item right accent-primary">
						<p class="period" data-translate="journeyDateThree">Jul 2022 &mdash; Dec 2022</p>
						<h3 data-translate="journeyJobThree">Software Development Intern</h3>
						<p class="company" data-translate="journeyCompThree">Grupo Uribe (GCO) &mdash; Medellín, Colombia</p>
						<p class="desc" data-translate="journeyDescThree">Support for internal scheduling platforms — automated Excel reporting to cut time-tracking effort by 15%, and improved usability by 20% through targeted HTML/JavaScript work.</p>
					</article>
				</div>
			</section>

			<section class="academic stack gap-4 bg-mist" style="position:relative; overflow:hidden; padding: 3rem 2rem; border-radius: 1.5rem; margin-inline: -1rem;">
				<span class="sec-numeral sec-numeral-right" aria-hidden="true">03</span>
				<div class="sec-head reveal">
					<span class="sec-label">03 — Formation</span>
					<h2 class="section-title" data-translate="academicTitle">Academic Foundation &amp; Certifications</h2>
				</div>
				<div class="academic-grid">
					<div class="academic-col">
						<div class="academic-col-header">
							<Icon icon="trophy" size="1.3em" />
							<h3 data-translate="academicStudiesTitle">Academic Studies</h3>
						</div>
						<ul class="academic-list">
							<li class="academic-item accent-primary">
								<span class="academic-date" data-translate="eduDateOne">Aug 2024 &mdash; Oct 2026 (est.)</span>
								<strong data-translate="eduDegOne">Technologist in Software Analysis &amp; Development</strong>
								<span class="academic-institution" data-translate="eduInstOne">SENA &mdash; Centro de Diseño y Metrología</span>
							</li>
							<li class="academic-item accent-secondary">
								<span class="academic-date" data-translate="eduDateTwo">Sep 2023</span>
								<strong data-translate="eduDegTwo">Vocational Technician &mdash; Software Development Assistant</strong>
								<span class="academic-institution" data-translate="eduInstTwo">Cesde Institución Educativa &mdash; Medellín</span>
							</li>
							<li class="academic-item accent-tertiary">
								<span class="academic-date" data-translate="eduDateThree">Nov 2013</span>
								<strong data-translate="eduDegThree">Academic Baccalaureate</strong>
								<span class="academic-institution" data-translate="eduInstThree">I.E. Tomas Cadavid &mdash; Medellín</span>
							</li>

						</ul>
					</div>
					<div class="academic-col">
						<div class="academic-col-header">
							<Icon icon="rocket-launch" size="1.3em" />
							<h3 data-translate="certTitle">Certifications</h3>
						</div>
						<ul class="academic-list cert-list">
							<li class="academic-item cert-item">
								<span class="cert-badge">🛡️</span>
								<span class="academic-date" data-translate="certDateOne">July 2025</span>
								<strong data-translate="certNameOne">DevSecOps Certified Associate</strong>
								<span class="academic-institution" data-translate="certInstOne">Case Study Certification</span>
							</li>
							<li class="academic-item cert-item">
								<span class="cert-badge">☁️</span>
								<span class="academic-date" data-translate="certDateTwo">Aug 2025</span>
								<strong data-translate="certNameTwo">Arquitectura en la nube Innovador - Avanzado</strong>
								<span class="academic-institution" data-translate="certInstTwo">IU Training (MinTIC) &middot; 159 hours</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- ── Contact ── -->
			<section class="contact-section reveal" id="contact">
				<div class="sec-head">
					<span class="sec-label" data-translate="contactLabel">Contact</span>
					<h2 class="section-title contact-title" data-translate="contactTitle">Let's build something with intention</h2>
					<p class="sec-lede" data-translate="contactDesc">Open to collaborations, roles, and good conversations about code, craft, and community.</p>
				</div>

				<div class="contact-strip">
					<div class="email-copy">
						<span class="email-text">hola@anamonsalve.com</span>
						<button class="copy-btn" aria-label="Copy email" data-email="hola@anamonsalve.com">
							<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
							<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</button>
					</div>
					<a href="mailto:hola@anamonsalve.com" class="btn-say-hello" data-translate="contactCta">Say hello</a>
					<a href="https://github.com/amonsalv" target="_blank" rel="noopener noreferrer" class="btn-github">GitHub</a>
				</div>
			</section>

		</main>
	</div>
</BaseLayout>

<style>
	.about-page {
		padding-top: 2.25rem;
		padding-bottom: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	/* Ochre/yellow tinted pill — like Claude Design */
	.eyebrow {
		display: inline-block;
		width: fit-content;
		padding: 7px 14px;
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		background: color-mix(in srgb, var(--chroma-sunny) 22%, var(--surface));
		color: color-mix(in srgb, var(--chroma-sunny) 65%, var(--on-surface));
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}
	:root.theme-dark .eyebrow {
		background: color-mix(in srgb, var(--chroma-sunny) 18%, transparent);
		color: var(--chroma-sunny);
	}

	.about-hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.35rem;
		align-items: center;
	}

	.about-hero h1 {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		line-height: 0.92;
		margin-top: 1rem;
		margin-bottom: 1.5rem;
		letter-spacing: -0.05em;
	}

	.about-l1 {
		display: block;
		font-weight: 800;
		color: var(--on-surface);
		line-height: 0.92;
	}

	/* "The soul of paint." — italic blue like hero index */
	.about-l2 {
		display: block;
		font-weight: 300;
		font-style: italic;
		color: var(--chroma-ocean);
	}

	.hero-desc {
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		max-width: 44ch;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.hero-art {
		background: linear-gradient(135deg, var(--chroma-ocean) 0%, var(--chroma-purple) 100%);
		border-radius: 2rem;
		padding: 1.5rem;
		box-shadow: 0 20px 40px rgba(21, 101, 192, 0.18);
		min-height: 280px;
		display: flex;
		align-items: stretch;
	}

	.art-frame {
		flex: 1;
		border-radius: 1.5rem;
		display: grid;
		place-items: center;
		padding: 1.5rem;
	}

	/* Inner bordered frame — igual al Claude Design */
	.art-frame-inner {
		width: 100%;
		height: 100%;
		min-height: 20rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 1.5rem;
		display: grid;
		place-items: center;
	}

	.mission-card {
		background: var(--surface-container-low);
		border-radius: 2rem;
		padding: 3.5rem 2.5rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	/* Decorative big quotation mark */
	.qmark {
		position: absolute;
		font-family: var(--font-display);
		font-size: 8rem;
		color: color-mix(in srgb, var(--chroma-purple) 20%, transparent);
		line-height: 1;
		top: 0.5rem;
		left: 1.5rem;
		pointer-events: none;
		user-select: none;
	}

	.mission-card h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin-bottom: 1.5rem;
		position: relative;
		z-index: 1;
	}

	.mission-card blockquote {
		font-size: clamp(1.1rem, 2.4vw, 1.35rem);
		font-style: italic;
		font-weight: 500;
		color: var(--chroma-ocean);
		max-width: 48ch;
		margin: 0 auto;
		line-height: 1.6;
		position: relative;
		z-index: 1;
		line-height: 1.5;
		font-weight: 500;
	}

	.toolbox-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr;
	}

	.tool-card {
		background: var(--surface-container-low);
		border-radius: 1.2rem;
		padding: 2rem;
	}

	.tool-card-header {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1.5rem;
	}

	.tool-card-header h3 {
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--on-surface);
	}

	.frontend .tool-card-header { color: var(--chroma-ocean); }
	.backend .tool-card-header { color: var(--chroma-nature); }
	.automation .tool-card-header { color: color-mix(in srgb, var(--chroma-sunny) 70%, var(--on-surface)); }
	.tools .tool-card-header { color: var(--chroma-purple); }

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.chips span {
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 999px;
	}

	.frontend .chips span {
		background: color-mix(in srgb, var(--chroma-ocean) 12%, transparent);
		color: var(--chroma-ocean-strong);
	}

	.backend .chips span {
		background: color-mix(in srgb, var(--chroma-nature) 12%, transparent);
		color: var(--chroma-nature);
	}

	.automation .chips span {
		background: color-mix(in srgb, var(--chroma-sunny) 18%, transparent);
		color: color-mix(in srgb, var(--chroma-sunny) 65%, var(--on-surface));
	}

	.tools .chips span {
		background: color-mix(in srgb, var(--chroma-purple) 12%, transparent);
		color: var(--chroma-purple);
	}

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-top: 1.5rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0.3rem;
		top: 0;
		bottom: 0;
		width: 2px;
		background: color-mix(in srgb, var(--outline-variant) 50%, transparent);
	}

	.timeline-item {
		position: relative;
		padding-left: 2.5rem;
		max-width: 58ch;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		left: -0.05rem; /* center the dot on the line */
		top: 0.4rem;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
	}

	.accent-primary p.period { color: var(--chroma-ocean); }
	.accent-secondary p.period { color: var(--chroma-nature); }
	.accent-tertiary p.period { color: var(--chroma-purple); }

	.accent-primary::before { background: var(--chroma-ocean); }
	.accent-secondary::before { background: var(--chroma-nature); }
	.accent-tertiary::before { background: var(--chroma-purple); }

	.timeline-item h3 {
		font-size: var(--text-2xl);
		margin-bottom: 0.2rem;
		font-weight: 800;
	}

	.company {
		font-size: var(--text-base);
		color: var(--on-surface-variant);
		margin-bottom: 0.8rem;
		font-weight: 500;
	}

	.desc {
		font-size: var(--text-md);
		color: var(--on-surface-variant);
		line-height: 1.6;
	}

	.period {
		font-size: var(--text-md);
		font-weight: 800;
		margin-bottom: 0.4rem;
	}

	:root.theme-dark .mission-card,
	:root.theme-dark .tool-card {
		background: var(--surface-container-lowest);
	}

	:root.theme-dark .frontend .chips span {
		background: color-mix(in srgb, var(--chroma-ocean) 22%, transparent);
		color: #90bfff;
	}

	:root.theme-dark .backend .chips span {
		background: color-mix(in srgb, var(--chroma-nature) 22%, transparent);
		color: #80cbc4;
	}

	:root.theme-dark .automation .chips span {
		background: color-mix(in srgb, var(--chroma-sunny) 22%, transparent);
		color: #ffe082;
	}

	:root.theme-dark .tools .chips span {
		background: color-mix(in srgb, var(--chroma-purple) 22%, transparent);
		color: #e0a8f5;
	}

	:root.theme-dark .about-hero h1,
	:root.theme-dark .hero-desc {
		color: #e5e5f5;
	}

	:root.theme-dark .eyebrow {
		background: color-mix(in srgb, var(--chroma-ocean) 18%, transparent);
		color: #90bfff;
	}

	:root.theme-dark .hero-art {
		background: linear-gradient(150deg, #0d47a1 0%, #4a148c 100%);
	}


	/* Academic section */
	.academic {
		padding-top: 0.5rem;
	}

	.academic h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	.academic-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.academic-col {
		padding: 0;
	}

	.academic-col-header {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1.5rem;
		color: var(--on-surface);
	}

	.academic-col-header h3 {
		font-size: 1rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--on-surface);
	}

	.academic-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}

	.academic-item {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 1rem;
		border-left: 3px solid transparent;
	}

	.academic-item.accent-primary { border-left-color: var(--chroma-ocean); }
	.academic-item.accent-secondary { border-left-color: var(--chroma-nature); }
	.academic-item.accent-tertiary { border-left-color: var(--chroma-purple); }

	.academic-date {
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--on-surface-variant);
	}

	.academic-item strong {
		font-size: 1rem;
		font-weight: 700;
		color: var(--on-surface);
		line-height: 1.3;
	}

	.academic-institution {
		font-size: 0.88rem;
		color: var(--on-surface-variant);
	}

	.cert-item {
		border-left: none;
		padding-left: 0;
		background: var(--surface-container-lowest);
		border-radius: 1rem;
		padding: 1rem 1.2rem;
		gap: 0.15rem;
		box-shadow: 0 2px 8px rgba(0,0,0,0.04);
	}

	.cert-badge {
		font-size: 1.5rem;
		margin-bottom: 0.4rem;
	}


	:root.theme-dark .cert-item {
		background: var(--surface-container);
	}

	@media (min-width: 50em) {
		.academic-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	:root.theme-dark .panel-painting {
		background: linear-gradient(135deg, #4a148c, #1a0033);
		color: rgba(255,255,255,0.9);
	}
	:root.theme-dark .panel-painting h3 { color: #fff; }

	@media (min-width: 50em) {
		.about-page {
			gap: 4rem;
		}

		.about-hero {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 4rem;
			align-items: center;
		}

		.hero-art {
			min-height: 500px;
		}

		.art-frame-inner {
			min-height: 380px;
		}

		.mission-card {

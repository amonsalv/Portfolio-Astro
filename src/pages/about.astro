	function updateAboutLanguage(language: string) {
		const t = language === 'es' ? aboutPageTranslations.es : aboutPageTranslations.en;
		Object.entries(t).forEach(([key, value]) => {
			document.querySelectorAll(`[data-translate="${key}"]`).forEach((el) => {
				el.innerHTML = value;
			});
		});
	}

	window.addEventListener('languageChange', (e) => {
		updateAboutLanguage(e.detail.language);
	});

	const savedLanguage = localStorage.getItem('language');
	const initialLanguage = savedLanguage || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (initialLanguage === 'es') updateAboutLanguage('es');

	// ── Copy email button ──
	const copyBtn = document.querySelector('.copy-btn') as HTMLButtonElement | null;
	if (copyBtn) {
		copyBtn.addEventListener('click', async () => {
			const email = copyBtn.dataset.email || 'hola@anamonsalve.com';
			try {
				await navigator.clipboard.writeText(email);
				copyBtn.classList.add('copied');
				setTimeout(() => copyBtn.classList.remove('copied'), 2000);
			} catch {

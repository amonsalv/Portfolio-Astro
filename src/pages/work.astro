---
import { getCollection, type CollectionEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('work');
const uniqueProjects = allProjects
	.filter((project: CollectionEntry<'work'>) => !project.id.includes('-es'))
	.sort((a: CollectionEntry<'work'>, b: CollectionEntry<'work'>) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featuredProjects = uniqueProjects.slice(0, 3);
---

<BaseLayout title="My Work | Ana Monsalve" description="Learn about Ana Monsalve's most recent projects">
	<div class="stack gap-20">
		<main class="work-page wrapper">
			<header class="work-hero">
				<span class="sec-label" data-translate="workLabel">Work</span>
				<h1 class="work-title">
					<span data-translate="workTitlePrefix">Selected</span>
					<em class="work-title-accent" data-translate="workTitleAccent">Works.</em>
				</h1>
				<p class="work-subtitle" data-translate="workSubtitle">
					A collection of digital experiences crafted with a developer's logic and a painter's eye.
				</p>
			</header>

			<section class="work-grid reveal" data-stagger aria-label="Featured projects">
				{
					featuredProjects.map((project) => {
						const spanishId = project.id.includes('.md') ? project.id.replace('.md', '-es.md') : `${project.id}-es`;
						// @ts-ignore
						const spanishProject = allProjects.find((p) => p.id === spanishId || p.slug === `${project.slug}-es`);
						return (
							<li class="project-item" data-en-slug={project.id} data-es-slug={spanishId}>
								<div class="project-en" style="display: block;">
									<a class="project-card" href={`/work/${project.id}`}>
										<div class="meta">
											<div class="pills">
												{project.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
											</div>
											<h2>{project.data.title}</h2>
											<p>{project.data.description}</p>
											<div class="proj-stack">
												{project.data.tags.slice(0, 4).map((tag: string) => <span class="dot">{tag}</span>)}
											</div>
										</div>
										<div class="img-container">
											<img src={project.data.img} alt={project.data.img_alt || ''} loading="lazy" decoding="async" />
										</div>
									</a>
								</div>
								{spanishProject && (
									<div class="project-es" style="display: none;">
										<a class="project-card" href={`/work/${spanishProject.id}`}>
											<div class="meta">
												<div class="pills">
													{spanishProject.data.tags.slice(0, 2).map((tag: string) => <span>{tag}</span>)}
												</div>
												<h2>{spanishProject.data.title}</h2>
												<p>{spanishProject.data.description}</p>
												<div class="proj-stack">
													{spanishProject.data.tags.slice(0, 4).map((tag: string) => <span class="dot">{tag}</span>)}
												</div>
											</div>
											<div class="img-container">
												<img src={spanishProject.data.img} alt={spanishProject.data.img_alt || ''} loading="lazy" decoding="async" />
											</div>
										</a>
									</div>
								)}
							</li>
						);
					})
				}

				<li class="cta-slot">
					<article class="project-cta-card">
						<p class="spark">✦ ✦ ✦</p>
						<h2 data-translate="workCtaTitle">Ready for your next collaboration?</h2>
						<a href="/about/#contact" data-translate="workCtaButton">Contact Ana</a>
					</article>
				</li>
			</section>
		</main>

	</div>

	<script>
		const workPageTranslations = {
			en: {
				workLabel: 'Work',
				workTitlePrefix: 'Selected',
				workTitleAccent: 'Works.',
				workSubtitle: "A collection of digital experiences crafted with a developer's logic and a painter's eye.",
				workCtaTitle: 'Ready for your next collaboration?',
				workCtaButton: 'Contact Ana',
			},
			es: {
				workLabel: 'Proyectos',
				workTitlePrefix: 'Trabajos',
				workTitleAccent: 'Seleccionados.',
				workSubtitle: 'Una colección de experiencias digitales creadas con la lógica de una desarrolladora y el ojo de una pintora.',
				workCtaTitle: '¿Lista para tu próxima colaboración?',
				workCtaButton: 'Contactar a Ana',
			},
		};

		function translateWorkPage(language: string) {
			const t = language === 'es' ? workPageTranslations.es : workPageTranslations.en;
			Object.entries(t).forEach(([key, value]) => {
				document.querySelectorAll(`[data-translate="${key}"]`).forEach((el) => {
					el.textContent = value;
				});
			});

			const projectItems = document.querySelectorAll('.project-item');
			projectItems.forEach((item) => {
				const enVersion = item.querySelector('.project-en') as HTMLElement | null;
				const esVersion = item.querySelector('.project-es') as HTMLElement | null;

				if (language === 'es') {
					if (enVersion) enVersion.style.display = 'none';
					if (esVersion) esVersion.style.display = 'block';
				} else {
					if (enVersion) enVersion.style.display = 'block';
					if (esVersion) esVersion.style.display = 'none';
				}
			});
		}

		const language = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
		translateWorkPage(language);
		window.addEventListener('languageChange', (e) => {
			// @ts-ignore
			translateWorkPage(e.detail.language);
		});
	</script>
</BaseLayout>

<style>
	.work-page {
		padding-top: 4rem;
		padding-bottom: 4rem;
		position: relative;
		overflow: hidden;
	}

	/* ── Hero ── */
	.work-hero {
		margin-bottom: 3.5rem;
	}

	.work-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 8vw, 6rem);
		font-weight: 800;
		line-height: 0.92;
		letter-spacing: -0.04em;
		margin: 0.75rem 0 1rem;
		color: var(--on-surface);
	}

	.work-title-accent {
		display: block;
		font-weight: 300;
		font-style: italic;
		color: var(--chroma-ocean);
	}

	.work-subtitle {
		font-size: clamp(1rem, 2vw, 1.15rem);
		max-width: 44ch;
		color: var(--on-surface-variant);
		line-height: 1.65;
	}

	/* ── Grid ── */
	.work-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
	}

	.project-item, .cta-slot { min-width: 0; }

	/* ── Project card ── */
	.project-card {
		display: flex;
		flex-direction: column;
		background: var(--surface-container-lowest);
		border-radius: 2rem;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		border: 1px solid transparent;
		transition: transform 0.3s var(--ease-expressive),
		            box-shadow 0.3s var(--ease-expressive),
		            border-color 0.3s var(--ease-expressive);
	}

	.project-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 40px rgba(0,0,0,0.08);
		border-color: color-mix(in srgb, var(--chroma-ocean) 28%, transparent);
	}

	.meta {
		padding: 1.75rem 1.75rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.project-card h2 {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3vw, 2.4rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--on-surface);
	}

	.project-card p {
		font-size: 0.95rem;
		color: var(--on-surface-variant);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── Pills / tags ── */
	.pills {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.pills span {
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.project-item:nth-child(1) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-ocean) 12%, transparent);  color: var(--chroma-ocean-strong); }
	.project-item:nth-child(1) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-purple) 10%, transparent); color: var(--chroma-purple); }
	.project-item:nth-child(2) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-purple) 12%, transparent); color: var(--chroma-purple); }
	.project-item:nth-child(2) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-ocean) 10%, transparent);  color: var(--chroma-ocean-strong); }
	.project-item:nth-child(3) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-nature) 12%, transparent); color: var(--chroma-nature); }
	.project-item:nth-child(3) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-sunny) 20%, transparent);  color: #5a3e00; }

	/* ── Tech stack dots ── */
	.proj-stack {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-top: 0.25rem;
	}

	.proj-stack .dot {
		font-family: var(--font-mono, monospace);
		font-size: 0.68rem;
		color: var(--on-surface-variant);
		border: 1px solid var(--outline-variant);
		border-radius: 6px;
		padding: 2px 8px;
	}

	/* ── Image container ── */
	.img-container {
		width: 100%;
		height: 16rem;
		overflow: hidden;
		flex-shrink: 0;
	}

	.img-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--ease-expressive);
		display: block;
	}

	.project-card:hover img { transform: scale(1.04); }

	/* ── CTA card ── */
	.project-cta-card {
		background: #0F121D;
		border-radius: 2rem;
		padding: 2.5rem 2rem;
		min-height: 18rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 1.25rem;
	}

	.project-cta-card .spark {
		font-size: 1.2rem;
		letter-spacing: 6px;
		color: var(--chroma-sunny);
	}

	.project-cta-card h2 {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 600;
		line-height: 1.15;
		color: #fff;
		max-width: 16ch;
	}

	.project-cta-card a {
		display: inline-flex;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.875rem;
		color: #fff;
		background: var(--chroma-ocean);
		text-decoration: none;
		transition: background 0.2s;
	}

	.project-cta-card a:hover {
		background: var(--chroma-ocean-strong);
		color: #fff;
	}

	/* ── Dark mode ── */
	:root.theme-dark .project-card {
		background: var(--surface-container);
		border-color: var(--surface-container-high);
	}

	:root.theme-dark .project-card h2 { color: var(--on-surface); }
	:root.theme-dark .project-card p  { color: var(--on-surface-variant); }

	:root.theme-dark .project-item:nth-child(1) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-ocean) 22%, transparent);  color: #90bfff; }
	:root.theme-dark .project-item:nth-child(1) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-purple) 22%, transparent); color: #e0a8f5; }
	:root.theme-dark .project-item:nth-child(2) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-purple) 22%, transparent); color: #e0a8f5; }
	:root.theme-dark .project-item:nth-child(2) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-ocean) 22%, transparent);  color: #90bfff; }
	:root.theme-dark .project-item:nth-child(3) .pills span:nth-child(odd)  { background: color-mix(in srgb, var(--chroma-nature) 22%, transparent); color: #80cbc4; }
	:root.theme-dark .project-item:nth-child(3) .pills span:nth-child(even) { background: color-mix(in srgb, var(--chroma-sunny) 18%, transparent);  color: #ffd740; }

	/* ── Desktop layout ── */
	@media (min-width: 50em) {
		.work-grid {
			grid-template-columns: 1.5fr 1fr;
			gap: 1.25rem;
		}

		/* Project 1: col 1 row 1, horizontal */
		.project-item:nth-child(1) {
			grid-column: 1;
			grid-row: 1;
		}
		.project-item:nth-child(1) .project-card {
			flex-direction: row;
			min-height: 22rem;
		}
		.project-item:nth-child(1) .meta {
			flex: 0 0 50%;
			justify-content: center;
			padding: 2.2rem;
		}
		.project-item:nth-child(1) .img-container {
			flex: 1;
			height: auto;
		}

		/* Project 2: col 2 row 1, vertical */
		.project-item:nth-child(2) {
			grid-column: 2;
			grid-row: 1;
		}

		/* Project 3: full-width landscape */
		.project-item:nth-child(3) {
			grid-column: 1 / -1;
			grid-row: 2;
		}
		.project-item:nth-child(3) .project-card {
			flex-direction: row;
			min-height: 18rem;
		}
		.project-item:nth-child(3) .img-container {
			flex: 1.1;
			height: auto;
		}
		.project-item:nth-child(3) .meta {
			flex: 1;
			justify-content: center;
			padding: 2.2rem;
		}

		/* CTA: full-width */
		.cta-slot {
			grid-column: 1 / -1;
			grid-row: 3;
		}
	}
</style>

---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import { ClientRouter } from 'astro:transitions';
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <MainHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <div class="stack backgrounds">
      <Nav />
      <slot />
      <Footer />
    </div>

    <script>
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ── Loaded class (triggers hero entrance) ── */
        const markLoaded = () => document.body.classList.add('loaded');
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(markLoaded));
        } else {
          requestAnimationFrame(markLoaded);
        }

        /* ── Scroll reveal + stagger ── */
        function bindReveal() {
          const els = document.querySelectorAll('.reveal');
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach(el => { el.classList.add('in'); });
            return;
          }
          const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (!e.isIntersecting) return;
              const el = e.target;
              el.classList.add('in');
              if (el.hasAttribute('data-stagger')) {
                Array.from(el.children).forEach((child, i) => {
                  (child as HTMLElement).style.setProperty('--d', `${i * 80}ms`);
                });
              }
              io.unobserve(el);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
          els.forEach(el => io.observe(el));
        }

        /* ── Panel tilt (desktop + non-touch only) ── */
        function bindTilt() {
          if (reduce || window.matchMedia('(pointer: coarse)').matches) return;
          document.querySelectorAll('[data-tilt]').forEach(el => {
            el.addEventListener('mousemove', (e: Event) => {
              const me = e as MouseEvent;
              const r = (el as HTMLElement).getBoundingClientRect();
              const px = (me.clientX - r.left) / r.width - 0.5;
              const py = (me.clientY - r.top)  / r.height - 0.5;
              (el as HTMLElement).style.transform =
                `perspective(1000px) rotateY(${px * 4}deg) rotateX(${-py * 4}deg) translateY(-4px)`;
            });
            el.addEventListener('mouseleave', () => {
              (el as HTMLElement).style.transform = '';
            });
          });
        }

        /* ── Nav scrolled state ── */
        function bindNavScroll() {
          const nav = document.querySelector('.site-header');
          if (!nav) return;
          const onScroll = () => {
            nav.classList.toggle('scrolled', window.scrollY > 60);
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        bindReveal();
        bindTilt();
        bindNavScroll();

        // Re-run on View Transitions page change
        document.addEventListener('astro:page-load', () => {
          document.body.classList.remove('loaded');
          requestAnimationFrame(() => document.body.classList.add('loaded'));
          bindReveal();
          bindTilt();
          bindNavScroll();
        });
      })();
    </script>

    <style>
      /* New Design System — Warm Editorial Minimalism */
      .backgrounds {
        min-height: 100%;
        isolation: isolate;
        background-color: var(--surface);
        transition: background-color var(--theme-transition);
      }

      @media (forced-colors: active) {
        .backgrounds {
          background: none;
        }
      }
    </style>
  </body>
</html>

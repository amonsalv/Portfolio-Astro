---
// ContactCTA — used at the bottom of individual project pages
---

<section class="contact-cta">
	<div class="cta-inner">
		<div class="cta-text">
			<span class="cta-label" data-translate="ctaLabel">Let's connect</span>
			<h2 class="cta-title" data-translate="ctaTitle">Ready for your next collaboration?</h2>
			<p class="cta-subtitle" data-translate="ctaSubtitle">
				Whether it's a line of code or a stroke of color, I'm always looking for the next meaningful project.
			</p>
		</div>
		<div class="cta-action">
			<a href="/about/#contact" class="cta-button">
				<span data-translate="ctaButton">Say hello</span>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
					<line x1="5" y1="12" x2="19" y2="12" />
					<polyline points="12 5 19 12 12 19" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.contact-cta {
		padding: 4rem 0 6rem;
	}

	.cta-inner {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		background: #0F0E1A;
		border-radius: 2rem;
		padding: 2.5rem 2rem;
		position: relative;
		overflow: hidden;
	}

	/* Glow decoration */
	.cta-inner::before {
		content: '';
		position: absolute;
		top: -30%;
		right: -5%;
		width: 350px;
		height: 350px;
		background: radial-gradient(circle, color-mix(in srgb, var(--chroma-ocean) 25%, transparent), transparent 70%);
		pointer-events: none;
	}

	.cta-inner::after {
		content: '';
		position: absolute;
		bottom: -30%;
		left: -5%;
		width: 250px;
		height: 250px;
		background: radial-gradient(circle, color-mix(in srgb, var(--chroma-purple) 18%, transparent), transparent 70%);
		pointer-events: none;
	}

	.cta-label {
		display: block;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: var(--chroma-sunny);
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.cta-title {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		color: #ffffff;
		max-width: 18ch;
		position: relative;
		z-index: 1;
	}

	.cta-subtitle {
		font-size: 0.95rem;
		line-height: 1.65;
		color: rgba(255,255,255,0.62);
		max-width: 44ch;
		margin-top: 0.75rem;
		position: relative;
		z-index: 1;
	}

	.cta-action {
		display: flex;
		position: relative;
		z-index: 1;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.5rem;
		border-radius: 999px;
		background: var(--chroma-ocean);
		color: #fff;
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		transition: background 0.2s, transform 0.2s;
	}

	.cta-button:hover {
		background: var(--chroma-ocean-strong);
		transform: translateY(-2px);
		color: #fff;
	}

	@media (min-width: 50em) {
		.cta-inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 3.5rem 4rem;
			gap: 3rem;
		}

		.cta-text { flex: 1; }
		.cta-action { flex-shrink: 0; }
	}
</style>

<script>
	const ctaT = {
		en: {
			ctaLabel: "Let's connect",
			ctaTitle: 'Ready for your next collaboration?',
			ctaSubtitle: "Whether it's a line of code or a stroke of color, I'm always looking for the next meaningful project.",
			ctaButton: 'Say hello',
		},
		es: {
			ctaLabel: 'Conectemos',
			ctaTitle: '¿Lista para tu próxima colaboración?',
			ctaSubtitle: 'Ya sea una línea de código o un trazo de color, siempre busco el próximo proyecto significativo.',
			ctaButton: 'Hablemos',
		},
	};

	function updateCTA(lang: string) {
		const t = lang === 'es' ? ctaT.es : ctaT.en;
		Object.entries(t).forEach(([key, value]) => {
			document.querySelectorAll(`[data-translate="${key}"]`).forEach(el => {
				el.textContent = value;
			});
		});
	}

	window.addEventListener('languageChange', (e) => {
		updateCTA(e.detail.language);
	});

	const saved = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (saved === 'es') updateCTA('es');
</script>

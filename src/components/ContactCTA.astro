---
import CallToAction from './CallToAction.astro';
// import Icon from './Icon.astro'; // Not used in this component
---

<aside>
	<h2 data-translate="contactCta.title">Interested in working together?</h2>
	<CallToAction href="https://www.linkedin.com/in/anamonsalve/">
		<span data-translate="contactCta.button">Send Me a Message</span>
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>

<script>
	// @ts-ignore
	import { useTranslations } from '../utils/i18n';

	function translateContactCTA() {
		const language = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
		// @ts-ignore
		const t = useTranslations(language);

		// Translate title
		const titleElement = document.querySelector('[data-translate="contactCta.title"]');
		if (titleElement) {
			titleElement.textContent = t.contactCta.title;
		}

		// Translate button
		const buttonElement = document.querySelector('[data-translate="contactCta.button"]');
		if (buttonElement) {
			buttonElement.textContent = t.contactCta.button;
		}
	}

	// Initial translation
	translateContactCTA();

	// Listen for language change events
	document.addEventListener('languageChanged', translateContactCTA);
</script>

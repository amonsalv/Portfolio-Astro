---
import Icon from './Icon.astro';
---

<!-- "How I Think" — 3 pillar cards from Stitch redesign -->
<section class="philosophy">
	<header class="philosophy-header">
		<div>
			<p class="section-label" data-translate="howIThinkLabel">HOW I THINK</p>
			<h2 class="philosophy-title" data-translate="howIThinkTitle">My philosophy isn't just about output; it's about the process behind every pixel and line.</h2>
		</div>
		<p class="philosophy-intro" data-translate="howIThinkIntro">My philosophy is not just about output. It is about the process behind every pixel and line.</p>
	</header>

	<div class="pillars">
		<article class="pillar">
			<div class="pillar-icon">
				<Icon icon="pencil-line" color="var(--primary)" size="1.5rem" />
			</div>
			<h3 class="pillar-name" data-translate="curiosity">Curiosity</h3>
			<p class="pillar-desc" data-translate="curiosityDesc">I approach every challenge like a blank canvas — asking the right questions before mixing the colors.</p>
		</article>

		<article class="pillar">
			<div class="pillar-icon">
				<Icon icon="terminal-window" color="var(--primary)" size="1.5rem" />
			</div>
			<h3 class="pillar-name" data-translate="logic">Logic</h3>
			<p class="pillar-desc" data-translate="logicDesc">Structured systems and scalable architecture are the foundations that allow creativity to truly fly.</p>
		</article>

		<article class="pillar">
			<div class="pillar-icon">
				<Icon icon="people" color="var(--primary)" size="1.5rem" />
			</div>
			<h3 class="pillar-name" data-translate="purpose">Purpose</h3>
			<p class="pillar-desc" data-translate="purposeDesc">I build for humans. Technology should serve a higher intent than just existing; it should solve real problems.</p>
		</article>
	</div>
</section>

<style>
	.philosophy {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
		padding: 3rem 0 4rem;
	}

	/* Label */
	.section-label {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--primary);
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	/* Header */
	.philosophy-header {
		display: grid;
		gap: 1.1rem;
		align-items: end;
	}

	.philosophy-title {
		font-family: var(--font-brand);
		font-size: clamp(2rem, 4vw, var(--text-4xl));
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--on-surface);
		max-width: 12ch;
	}

	.philosophy-intro {
		font-size: var(--text-base);
		line-height: 1.5;
		color: var(--on-surface-variant);
		max-width: 38ch;
		justify-self: end;
	}

	/* Pillar grid */
	.pillars {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	/* Single pillar card */
	.pillar {
		background: var(--surface-container-lowest);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: 0 20px 40px rgba(26, 28, 27, 0.04);
		border: 1px solid color-mix(in srgb, var(--outline-variant) 35%, transparent);
		transition: box-shadow 0.2s var(--ease-expressive), transform 0.2s var(--ease-expressive);
	}

	.pillar:nth-child(1) {
		border-top: 3px solid color-mix(in srgb, var(--primary) 55%, white);
	}

	.pillar:nth-child(2) {
		border-top: 3px solid #d8a164;
	}

	.pillar:nth-child(3) {
		border-top: 3px solid #df8186;
	}

	.pillar:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.pillar-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		background: var(--primary-fixed);
		border-radius: var(--radius-md);
		margin-bottom: 1.25rem;
		flex-shrink: 0;
	}

	:root.theme-dark .pillar-icon {
		background: rgba(194, 193, 255, 0.12);
	}

	.pillar-name {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--on-surface);
		margin-bottom: 0.75rem;
		line-height: 1.1;
	}

	.pillar-desc {
		font-family: var(--font-body);
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--on-surface-variant);
	}

	@media (min-width: 50em) {
		.philosophy {
			gap: 3rem;
			padding: 5rem 0;
		}

		.philosophy-header {
			grid-template-columns: 1.2fr 1fr;
			gap: 2rem;
		}

		.pillars {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}
</style>

<script>
	const philosophyTranslations = {
		en: {
			howIThinkLabel: 'HOW I THINK',
			howIThinkTitle: "My philosophy isn't just about output; it's about the process behind every pixel and line.",
			howIThinkIntro: 'My philosophy is not just about output. It is about the process behind every pixel and line.',
			curiosity: 'Curiosity',
			curiosityDesc: 'I approach every challenge like a blank canvas — asking the right questions before mixing the colors.',
			logic: 'Logic',
			logicDesc: 'Structured systems and scalable architecture are the foundations that allow creativity to truly fly.',
			purpose: 'Purpose',
			purposeDesc: 'I build for humans. Technology should serve a higher intent than just existing; it should solve real problems.',
		},
		es: {
			howIThinkLabel: 'CÓMO PIENSO',
			howIThinkTitle: 'Mi filosofía no se trata solo del resultado; es sobre el proceso detrás de cada píxel y línea.',
			howIThinkIntro: 'Mi filosofia no es solo sobre el resultado. Es sobre el proceso detras de cada pixel y linea.',
			curiosity: 'Curiosidad',
			curiosityDesc: 'Abordo cada reto como un lienzo en blanco: haciendo las preguntas correctas antes de mezclar los colores.',
			logic: 'Lógica',
			logicDesc: 'Los sistemas estructurados y la arquitectura escalable son las bases que permiten que la creatividad vuele.',
			purpose: 'Propósito',
			purposeDesc: 'Construyo para las personas. La tecnología debe servir un propósito mayor que solo existir; debe resolver problemas reales.',
		},
	};

	// @ts-ignore
	function updatePhilosophyLanguage(language) {
		// @ts-ignore
		const t = language === 'es' ? philosophyTranslations.es : philosophyTranslations.en;
		const keys = Object.keys(t) as Array<keyof typeof t>;
		keys.forEach((key) => {
			const el = document.querySelector(`[data-translate="${key}"]`);
			// @ts-ignore
			if (el) el.textContent = t[key];
		});
	}

	window.addEventListener('languageChange', (e) => {
		// @ts-ignore
		updatePhilosophyLanguage(e.detail.language);
	});

	const saved = localStorage.getItem('language');
	const init = saved || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (init === 'es') updatePhilosophyLanguage('es');
</script>

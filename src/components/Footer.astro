---
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="footer">
	<div class="footer-inner">
		<div class="footer-top reveal" data-stagger>

			<!-- Col 1: Brand -->
			<div class="footer-col">
				<p class="footer-mono">Ana Monsalve</p>
				<p class="footer-tag" data-translate="footerTagline">Software developer &amp; automation engineer. Building intentionally from Medellín.</p>
			</div>

			<!-- Col 2: Navigate -->
			<div class="footer-col">
				<h4 data-translate="footerNav">Navigate</h4>
				<a href="/"          data-translate="footerWork">Work</a>
				<a href="/about/"    data-translate="footerAbout">About</a>
				<a href="/#community" data-translate="footerCommunity">Community</a>
				<a href="/about/#contact" data-translate="footerContact">Contact</a>
			</div>

			<!-- Col 3: Socials -->
			<div class="footer-col footer-social">
				<h4 data-translate="footerElsewhere">Elsewhere</h4>
				<a href="https://github.com/amonsalv" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.6.5.5 5.6.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0C17 4.5 18 4.8 18 4.8c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.6 18.4.5 12 .5z"/></svg>
					amonsalv
				</a>
				<a href="https://linkedin.com/in/anamonsalve" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.4H3.5V9h3.6v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
					amonsalv
				</a>
				<a href="https://twitter.com/AnaMb266" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.6h3.7l-8 9.1 9.4 12.4h-7.4l-5.8-7.6-6.6 7.6H.5l8.5-9.7L0 1.6h7.6l5.2 6.9 6.1-6.9zm-1.3 19.8h2L6.5 3.7H4.4l13.2 17.7z"/></svg>
					@AnaMb266
				</a>
			</div>

		</div>

		<div class="footer-bottom reveal">
			<span data-translate="footerCopyright">© {currentYear} Ana Monsalve — Medellín, Colombia</span>
			<span data-translate="footerCredit">Designed with intention · Built with care</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		margin-top: auto;
		background: #0F0E1A;
		color: rgba(255,255,255,0.55);
		font-size: var(--text-sm);
	}

	.footer-inner {
		max-width: min(84rem, 92vw);
		margin-inline: auto;
		padding: 3.5rem clamp(1.2rem, 3vw, 2.5rem) 2rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	/* ── Top: 3 columns ── */
	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255,255,255,0.07);
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-mono {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 300;
		font-size: 1.8rem;
		color: var(--chroma-ocean);
		letter-spacing: -0.02em;
		line-height: 1;
		margin-bottom: 0.25rem;
	}

	.footer-tag {
		color: rgba(255,255,255,0.45);
		font-size: 0.875rem;
		line-height: 1.6;
		max-width: 28ch;
	}

	.footer-col h4 {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(255,255,255,0.35);
		margin-bottom: 0.25rem;
	}

	.footer-col a {
		color: rgba(255,255,255,0.55);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.footer-col a:hover { color: #fff; }

	/* Social links with icon */
	.footer-social a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-social svg {
		width: 14px;
		height: 14px;
		fill: currentColor;
		flex-shrink: 0;
	}

	/* ── Bottom ── */
	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		color: rgba(255,255,255,0.28);
		font-size: 0.8rem;
	}

	/* ── Desktop ── */
	@media (min-width: 50em) {
		.footer-top {
			grid-template-columns: 1.6fr 1fr 1fr;
		}

		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
		}
	}
</style>

<script>
const footerT = {
	en: {
		footerTagline: 'Software developer & automation engineer. Building intentionally from Medellín.',
		footerNav: 'Navigate',
		footerWork: 'Work',
		footerAbout: 'About',
		footerCommunity: 'Community',
		footerContact: 'Contact',
		footerElsewhere: 'Elsewhere',
		footerCopyright: `© ${new Date().getFullYear()} Ana Monsalve — Medellín, Colombia`,
		footerCredit: 'Designed with intention · Built with care',
	},
	es: {
		footerTagline: 'Desarrolladora de software e ingeniería en automatización. Construyendo con intención desde Medellín.',
		footerNav: 'Navegar',
		footerWork: 'Trabajo',
		footerAbout: 'Acerca de',
		footerCommunity: 'Comunidad',
		footerContact: 'Contacto',
		footerElsewhere: 'Redes',
		footerCopyright: `© ${new Date().getFullYear()} Ana Monsalve — Medellín, Colombia`,
		footerCredit: 'Diseñado con intención · Construido con cuidado',
	},
};

function updateFooter(lang: string) {
	const t = lang === 'es' ? footerT.es : footerT.en;
	Object.entries(t).forEach(([key, value]) => {
		document.querySelectorAll(`[data-translate="${key}"]`).forEach(el => {
			el.textContent = value;
		});
	});
}

window.addEventListener('languageChange', (e) => {
	updateFooter(e.detail.language);
});

const saved = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
if (saved === 'es') updateFooter('es');
</script>

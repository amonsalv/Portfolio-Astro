---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="brand-block">
		<p class="brand-name">Ana Monsalve</p>
		<p class="signature">
			<span data-translate="designedIn">Designed & Developed in Colombia</span>
			<span class="accent">🇨🇴</span>
			<span data-translate="withLove">with love</span>
		</p>
		<p class="copyright" data-translate="copyright">&copy; {currentYear} Ana Monsalve</p>
	</div>
	<nav class="socials" aria-label="Social links">
		<a href="https://x.com/_amonsalv" data-translate="twitter">Instagram</a>
		<a href="https://github.com/amonsalv" data-translate="github">GitHub</a>
		<a href="https://www.linkedin.com/in/anamonsalve/" data-translate="linkedin">LinkedIn</a>
	</nav>
	<a href="mailto:hola@anamonsalve.com" class="footer-cta" data-translate="getInTouch">Get in touch</a>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		margin-top: auto;
		padding: 2rem 1.5rem 2.6rem;
		color: var(--on-surface-variant);
		font-size: var(--text-sm);
		background: var(--surface-container-low);
		border-radius: var(--radius-xl) var(--radius-xl) 0 0;
	}

	footer a {
		color: var(--gray-400);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		text-decoration-color: currentColor;
	}

	.brand-block {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.brand-name {
		font-family: var(--font-body);
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--on-surface);
	}

	.signature {
		display: inline-flex;
		gap: 0.35rem;
		flex-wrap: wrap;
		align-items: center;
	}

	.copyright {
		opacity: 0.78;
	}

	.socials {
		display: flex;
		justify-content: flex-start;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-cta {
		display: inline-flex;
		justify-content: center;
		align-items: center;
		padding: 0.55rem 1rem;
		border-radius: var(--radius-full);
		background: var(--primary);
		color: var(--on-primary);
		font-weight: 700;
		width: fit-content;
	}

	.footer-cta:hover {
		color: var(--on-primary);
	}

	@media (min-width: 50em) {
		footer {
			display: grid;
			grid-template-columns: 1.3fr 1fr auto;
			align-items: center;
			gap: 1.5rem;
			padding: 2.4rem 2.2rem;
		}

		.brand-block {
			align-items: flex-start;
		}

		.socials {
			justify-content: center;
		}

		.footer-cta {
			justify-self: end;
		}
	}
</style>

<script>
// Footer translations
const footerTranslations = {
	en: {
		designedIn: 'Designed & Developed in Colombia',
		withLove: 'with love',
		copyright: `© ${new Date().getFullYear()} Ana Monsalve`,
		twitter: 'Instagram',
		github: 'GitHub',
		linkedin: 'LinkedIn',
		getInTouch: 'Get in touch',
	},
	es: {
		designedIn: 'Disenado y Desarrollado en Colombia',
		withLove: 'con amor',
		copyright: `© ${new Date().getFullYear()} Ana Monsalve`,
		twitter: 'Instagram',
		github: 'GitHub',
		linkedin: 'LinkedIn',
		getInTouch: 'Escribeme',
	}
};

// @ts-ignore - Parameter type inferred from usage
function updateFooter(language) {
	// Use direct object access to avoid TypeScript indexing issues
	let t;
	if (language === 'es') {
		t = footerTranslations.es;
	} else {
		t = footerTranslations.en;
	}
	
	// Update all elements with data-translate attributes
	Object.entries(t).forEach(([key, value]) => {
		const element = document.querySelector(`footer [data-translate="${key}"]`);
		if (element) {
			element.textContent = value;
		}
	});
}

// Listen for language changes from LanguageToggle component
window.addEventListener('languageChange', (e) => {
	// @ts-ignore - Custom event from LanguageToggle component
	updateFooter(e.detail.language);
});

// Initialize with saved language or browser preference
const savedLanguage = localStorage.getItem('language');
const initialLanguage = savedLanguage || (navigator.language.startsWith('es') ? 'es' : 'en');
if (initialLanguage === 'es') {
	updateFooter('es');
}
</script>

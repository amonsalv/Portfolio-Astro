---
// import Icon from './Icon.astro'; // Not used in this component
---

<language-toggle>
	<button>
		<span class="sr-only">Toggle language</span>
		<span class="lang-option en">EN</span>
		<span class="lang-option es">ES</span>
	</button>
</language-toggle>

<style>
	button {
		display: flex;
		align-items: center;
		border: 0;
		border-radius: 999rem;
		padding: 0.25rem;
		background-color: var(--gray-999);
		box-shadow: inset 0 0 0 1px var(--accent-overlay);
		cursor: pointer;
		position: relative;
		overflow: hidden;
	}

	.lang-option {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.375rem 0.625rem;
		font-size: 0.75rem;
		font-weight: 700;
		border-radius: 999rem;
		transition: all var(--theme-transition);
		min-width: 1.75rem;
		z-index: 2;
	}

	/* Default state - both options visible with muted colors */
	.lang-option {
		color: var(--gray-400);
		background-color: transparent;
	}

	/* Active state for EN (default) */
	:global(html:not(.lang-es)) .lang-option.en {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		box-shadow: var(--shadow-sm);
	}

	/* Active state for ES */
	:global(.lang-es) .lang-option.es {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		box-shadow: var(--shadow-sm);
	}

	/* Hover effects */
	.lang-option:hover {
		color: var(--gray-100);
		background-color: var(--gray-800);
	}

	/* Active option should not change on hover */
	:global(html:not(.lang-es)) .lang-option.en:hover,
	:global(.lang-es) .lang-option.es:hover {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	@media (prefers-reduced-motion: no-preference) {
		.lang-option {
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition),
				box-shadow var(--theme-transition);
		}
	}

	@media (forced-colors: active) {
		.lang-option.en,
		.lang-option.es {
			background-color: SelectedItem;
			color: SelectedItemText;
		}
	}
</style>

<script>
	class LanguageToggle extends HTMLElement {
		constructor() {
			super();

			const button = this.querySelector('button')!;

			/** Set the language to English/Spanish. */
			const setLanguage = (spanish: boolean) => {
				document.documentElement.classList[spanish ? 'add' : 'remove']('lang-es');
				button.setAttribute('aria-pressed', String(spanish));
				
				// Store preference in localStorage
				localStorage.setItem('language', spanish ? 'es' : 'en');
				
				// Dispatch custom event for other components to listen to
				window.dispatchEvent(new CustomEvent('languageChange', { 
					detail: { language: spanish ? 'es' : 'en' } 
				}));
			};

			// Toggle the language when a user clicks the button.
			button.addEventListener('click', () => setLanguage(!this.isSpanish()));

			// Initialize button state to reflect current language preference.
			const savedLanguage = localStorage.getItem('language');
			const isSpanish = savedLanguage === 'es' || 
				(!savedLanguage && navigator.language.startsWith('es'));
			
			setLanguage(isSpanish);
		}

		isSpanish() {
			return document.documentElement.classList.contains('lang-es');
		}
	}
	customElements.define('language-toggle', LanguageToggle);
</script>
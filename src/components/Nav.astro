---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import type { iconPaths } from './IconPaths';

const textLinks: { label: string; href: string; key: string }[] = [
	{ label: 'Home', href: '/', key: 'home' },
	{ label: 'About', href: '/about/', key: 'about' },
	{ label: 'Work', href: '/work/', key: 'work' },
];

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'Twitter', href: 'https://x.com/_amonsalv', icon: 'twitter-logo' },
	{ label: 'GitHub', href: 'https://github.com/amonsalv', icon: 'github-logo' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/anamonsalve/', icon: 'linkedin-logo' },
];
---

<header class="site-header">
	<div class="header-inner">
		<!-- Logo -->
		<a href="/" class="site-logo">
			<span>Ana Monsalve</span>
		</a>

		<!-- Desktop nav links + actions -->
		<nav class="desktop-nav" aria-label="main navigation">
			<ul class="nav-links" role="list">
				{
					textLinks.map(({ label, href, key }) => (
						<li>
							<a
								href={href}
								data-translate={key}
								class:list={[
									'nav-link',
									{
										active:
											Astro.url.pathname === href ||
											(href !== '/' && Astro.url.pathname.startsWith(href)),
									},
								]}
								aria-current={
									Astro.url.pathname === href ||
									(href !== '/' && Astro.url.pathname.startsWith(href))
										? 'page'
										: undefined
								}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="nav-actions">
				<div class="desktop-toggles">
					<ThemeToggle />
					<LanguageToggle />
				</div>
				<div class="nav-separator" aria-hidden="true"></div>
				<a href="mailto:hola@anamonsalve.com" class="email-link" aria-label="Email">
					<Icon icon="envelope" size="1.25em" />
				</a>
			</div>
		</nav>

		<!-- Mobile hamburger -->
		<menu-button>
			<template>
				<button class="menu-btn" aria-expanded="false" aria-label="Abrir menú">
					<Icon icon="list" size="1.4em" />
				</button>
			</template>
		</menu-button>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-nav" hidden>
		<ul class="mobile-links" role="list">
			{
				textLinks.map(({ label, href, key }) => (
					<li>
						<a
							href={href}
							data-translate={`m-${key}`}
							class:list={[
								'mobile-link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mobile-footer">
			<div class="mobile-socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social-link" target="_blank" rel="noopener noreferrer">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} size="1.2em" />
						</a>
					))
				}
			</div>
			<div class="mobile-controls">
				<ThemeToggle />
				<LanguageToggle />
			</div>
		</div>
	</div>
</header>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const menu = document.getElementById('mobile-nav')!;
			menu.hidden = true;

			const setExpanded = (open: boolean) => {
				btn.setAttribute('aria-expanded', String(open));
				menu.hidden = !open;
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));

			const mq = window.matchMedia('(min-width: 50em)');
			const onMQ = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			onMQ(mq);
			mq.addEventListener('change', onMQ);
		}
	}
	customElements.define('menu-button', MenuButton);

	const navT = {
		en: { home: 'Home', about: 'About', work: 'Work' },
		es: { home: 'Inicio', about: 'Acerca de', work: 'Proyectos' },
	};

	// @ts-ignore
	function updateNav(lang) {
		// @ts-ignore
		const t = lang === 'es' ? navT.es : navT.en;
		(['home', 'about', 'work'] as const).forEach((k) => {
			document.querySelectorAll(`[data-translate="${k}"], [data-translate="m-${k}"]`).forEach((el) => {
				el.textContent = t[k];
			});
		});
	}

	window.addEventListener('languageChange', (e) => {
		// @ts-ignore
		updateNav(e.detail.language);
	});

	const saved = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (saved === 'es') updateNav('es');
</script>

<style>
	/* ══════════════════════════════
	   HEADER  
	   ══════════════════════════════ */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--surface) 95%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid color-mix(in srgb, var(--outline-variant) 25%, transparent);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: 100%;
		max-width: min(84rem, 92vw);
		margin-inline: auto;
		padding: 1rem clamp(1.2rem, 3vw, 2rem);
	}

	/* ── Logo ── */
	.site-logo {
		display: flex;
		align-items: center;
		font-family: var(--font-body);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--on-surface);
		text-decoration: none;
		letter-spacing: -0.02em;
		white-space: nowrap;
		flex-shrink: 0;
		transition: opacity var(--theme-transition);
	}

	.site-logo:hover { opacity: 0.8; }

	.desktop-nav {
		display: none;
		align-items: center;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		display: inline-block;
		padding: 0.4rem 0;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--on-surface-variant);
		text-decoration: none;
		letter-spacing: -0.01em;
		transition: color var(--theme-transition);
		border-bottom: 2px solid transparent;
		margin-bottom: -2px; /* Pulls text up relative to container if needed */
	}

	.nav-link:hover {
		color: var(--on-surface);
	}

	.nav-link.active {
		color: var(--primary);
		border-bottom-color: var(--primary);
	}

	/* ── Nav actions ── */
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-left: 0.5rem;
	}
	
	.desktop-toggles {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-separator {
		width: 1px;
		height: 1.25rem;
		background-color: var(--outline-variant);
		opacity: 0.5;
	}

	.email-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--on-surface-variant);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.email-link:hover {
		color: var(--primary);
	}

	/* ── Mobile hamburger ── */
	.menu-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: none;
		border-radius: var(--radius-md);
		background: var(--surface-container-high);
		color: var(--on-surface);
		cursor: pointer;
		transition: background var(--theme-transition);
	}

	.menu-btn:hover { background: var(--surface-container-highest); }
	.menu-btn[hidden] { display: none; }

	/* ── Mobile dropdown ── */
	#mobile-nav {
		border-top: 1px solid var(--outline-variant);
		background: var(--surface-container-lowest);
		padding: 1rem 1.5rem;
	}

	.mobile-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.mobile-link {
		display: block;
		padding: 0.75rem 0.5rem;
		font-family: var(--font-body);
		font-size: var(--text-base);
		font-weight: 500;
		color: var(--on-surface-variant);
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color var(--theme-transition);
	}

	.mobile-link:hover,
	.mobile-link.active { color: var(--primary); }

	.mobile-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 0.5rem 0.25rem;
		margin-top: 0.5rem;
		border-top: 1px solid var(--outline-variant);
	}

	.mobile-socials {
		display: flex;
		gap: 0.25rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		color: var(--on-surface-variant);
		text-decoration: none;
		border-radius: var(--radius-full);
		transition: color var(--theme-transition);
	}

	.social-link:hover { color: var(--primary); }

	.mobile-controls {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	/* ══════════════════════════════
	   DESKTOP (≥ 50em)
	   ══════════════════════════════ */
	@media (min-width: 50em) {
		.desktop-nav {
			display: flex;
		}
		menu-button {
			display: none !important;
		}
		#mobile-nav {
			display: none !important;
		}
	}

	@media (forced-colors: active) {
		.nav-link.active { color: SelectedItem; }
	}
</style>

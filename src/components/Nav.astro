---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';


const textLinks: { label: string; href: string; key: string }[] = [
	{ label: 'Home', href: '/', key: 'home' },
	{ label: 'Work', href: '/work/', key: 'work' },
	{ label: 'About', href: '/about/', key: 'about' },
];


---

<header class="site-header">
	<div class="header-inner">
		<!-- Logo -->
		<a href="/" class="site-logo">
			<span>Ana Monsalve</span>
		</a>

		<!-- Desktop nav links (centered) -->
		<nav class="desktop-nav" aria-label="main navigation">
			<ul class="nav-links" role="list">
				{
					textLinks.map(({ label, href, key }) => (
						<li>
							<a
								href={href}
								data-translate={key}
								class:list={[
									'nav-link',
									{
										active:
											Astro.url.pathname === href ||
											(href !== '/' && Astro.url.pathname.startsWith(href)),
									},
								]}
								aria-current={
									Astro.url.pathname === href ||
									(href !== '/' && Astro.url.pathname.startsWith(href))
										? 'page'
										: undefined
								}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Desktop actions (right side) -->
		<div class="nav-actions">
			<LanguageToggle />
			<ThemeToggle />
			<a href="/about/#contact" class="nav-cta" data-translate="navCta">Say hello</a>
		</div>

		<!-- Mobile hamburger -->
		<menu-button>
			<template>
				<button class="menu-btn" aria-expanded="false" aria-label="Abrir menú">
					<Icon icon="list" size="1.4em" />
				</button>
			</template>
		</menu-button>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-nav" hidden>
		<ul class="mobile-links" role="list">
			{
				textLinks.map(({ label, href, key }) => (
					<li>
						<a
							href={href}
							data-translate={`m-${key}`}
							class:list={[
								'mobile-link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mobile-footer">
			<a href="/about/#contact" class="mobile-cta" data-translate="m-navCta">Say hello</a>
			<div class="mobile-controls">
				<ThemeToggle />
				<LanguageToggle />
			</div>
		</div>
	</div>
</header>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const menu = document.getElementById('mobile-nav')!;
			menu.hidden = true;

			const setExpanded = (open: boolean) => {
				btn.setAttribute('aria-expanded', String(open));
				menu.hidden = !open;
			};

		btn.addEventListener('click', () => setExpanded(!menu.hidden));

		const mq = window.matchMedia('(min-width: 50em)');
		const onMQ = (e: MediaQueryList | MediaQueryListEvent) => {
			setExpanded(e.matches);
			btn.hidden = e.matches;
		};
		onMQ(mq);
		mq.addEventListener('change', onMQ);
	}
}
	customElements.define('menu-button', MenuButton);

	const navT = {
		en: { home: 'Home', work: 'Work', about: 'About', navCta: 'Say hello' },
		es: { home: 'Inicio', work: 'Proyectos', about: 'Acerca de', navCta: 'Hablemos' },
	};

	function updateNav(lang: 'en' | 'es') {
		const t = lang === 'es' ? navT.es : navT.en;
		(['home', 'work', 'about', 'navCta'] as const).forEach((k) => {
			document.querySelectorAll(`[data-translate="${k}"], [data-translate="m-${k}"]`).forEach((el) => {
				el.textContent = t[k];
			});
		});
	}

	window.addEventListener('languageChange', (e) => {
		updateNav(e.detail.language);
	});

	const saved = localStorage.getItem('language') || (navigator.language.startsWith('es') ? 'es' : 'en');
	if (saved === 'es') updateNav('es');
</script>

<style>
	/* ══════════════════════════════
	   HEADER  
	   ══════════════════════════════ */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--surface) 95%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid color-mix(in srgb, var(--outline-variant) 25%, transparent);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		max-width: min(84rem, 92vw);
		margin-inline: auto;
		padding: 0.9rem clamp(1.2rem, 3vw, 2rem);
	}

	/* ── Logo ── */
	.site-logo {
		display: flex;
		align-items: center;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.35rem;
		font-weight: 300;
		color: var(--chroma-ocean);
		text-decoration: none;
		letter-spacing: -0.02em;
		white-space: nowrap;
		flex-shrink: 0;
		transition: opacity var(--theme-transition);
	}

	.site-logo:hover { opacity: 0.8; }

	.desktop-nav {
		display: none;
		flex: 1;
		justify-content: center;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		display: inline-block;
		padding: 0.4rem 0;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--on-surface-variant);
		text-decoration: none;
		letter-spacing: -0.01em;
		transition: color var(--theme-transition);
		border-bottom: 2px solid transparent;
		margin-bottom: -2px; /* Pulls text up relative to container if needed */
	}

	.nav-link:hover {
		color: var(--on-surface);
	}

	.nav-link.active {
		color: var(--on-surface);
		border-bottom-color: var(--on-surface);
	}

	/* ── Nav actions (right) ── */
	.nav-actions {
		display: none;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	/* "Say hello" CTA button */
	.nav-cta {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 1.1rem;
		border-radius: 999px;
		background: var(--chroma-ocean);
		color: #fff;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		letter-spacing: -0.01em;
		white-space: nowrap;
		transition: background 0.2s, transform 0.2s;
	}

	.nav-cta:hover {
		background: var(--chroma-ocean-strong);
		transform: translateY(-1px);
	}

	/* ── Mobile hamburger ── */
	.menu-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: none;
		border-radius: var(--radius-md);
		background: var(--surface-container-high);
		color: var(--on-surface);
		cursor: pointer;
		transition: background var(--theme-transition);
	}

	.menu-btn:hover { background: var(--surface-container-highest); }
	.menu-btn[hidden] { display: none; }

	/* ── Mobile dropdown ── */
	#mobile-nav {
		border-top: 1px solid var(--outline-variant);
		background: var(--surface-container-lowest);
		padding: 1rem 1.5rem;
	}

	.mobile-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.mobile-link {
		display: block;
		padding: 0.75rem 0.5rem;
		font-family: var(--font-body);
		font-size: var(--text-base);
		font-weight: 500;
		color: var(--on-surface-variant);
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color var(--theme-transition);
	}

	.mobile-link:hover,
	.mobile-link.active { color: var(--primary); }

	.mobile-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 0.5rem 0.25rem;
		margin-top: 0.5rem;
		border-top: 1px solid var(--outline-variant);
	}

	/* Mobile "Say hello" CTA */
	.mobile-cta {
		display: inline-flex;
		padding: 0.45rem 1.1rem;
		border-radius: 999px;
		background: var(--chroma-ocean);
		color: #fff;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 0.2s;
	}

	.mobile-cta:hover { background: var(--chroma-ocean-strong); color: #fff; }

	.mobile-controls {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	/* ══════════════════════════════
	   DESKTOP (≥ 50em)
	   ══════════════════════════════ */
	@media (min-width: 50em) {
		.desktop-nav {
			display: flex;
		}
		.nav-actions {
			display: flex;
		}
		menu-button {
			display: none !important;
		}
		#mobile-nav {
			display: none !important;
		}
	}

	@media (forced-colors: active) {
		.nav-link.active { color: SelectedItem; }
	}
</style>
